<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lertaro modification: target Windows broadly and copy the Windows SDK projection assemblies beside the app. -->

  <!--
    Shared presentation layer: the glass window base, the palette and the theme service.

    Every visible surface depends on this, which is how the Dock, the launchpad and the
    settings window are kept visually identical rather than merely similar.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <WindowsSdkPackageVersion>10.0.26100.57</WindowsSdkPackageVersion>
    <RootNamespace>GlassDesk.UI</RootNamespace>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The already-verified diagnostic source uses the sample analyzer policy. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.Windows.SDK.NET.Ref.Windows" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlassDesk.Core\GlassDesk.Core.csproj" />
    <ProjectReference Include="..\GlassDesk.Platform\GlassDesk.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)/microsoft.windows.sdk.net.ref/$(WindowsSdkPackageVersion)/lib/net8.0/Microsoft.Windows.SDK.NET.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)/microsoft.windows.sdk.net.ref/$(WindowsSdkPackageVersion)/lib/net8.0/WinRT.Runtime.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Effects/TransitionGlass.ps" />
  </ItemGroup>

</Project>
