<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Lertaro.App.Converters"
                    xmlns:services="clr-namespace:Lertaro.App.Services"
                    xmlns:settings="clr-namespace:Lertaro.App.Views.Settings"
                    xmlns:pconv="clr-namespace:Lertaro.App.Views.Settings.Plugins"
                    xmlns:helpers="clr-namespace:Lertaro.App.Helpers.Visuals">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Colors.xaml"/>
        <!-- Controls.xaml supplies the shared TextBox base needed by the settings styles below. -->
        <ResourceDictionary Source="../Controls/Controls.xaml"/>
        <ResourceDictionary Source="../Controls/Button.xaml"/>
        <!-- ComboBox chrome is kept separate because its popup template is self-contained. -->
        <ResourceDictionary Source="SettingsComboBox.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
        
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="SettingsHintText" TargetType="TextBlock">

        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="helpers:BackgroundReveal.Resource" Value="SettingsCardBackground"/>
        <Setter Property="Background" Value="{DynamicResource SettingsCardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <Style x:Key="SettingsRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsRowBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,10"/>
    </Style>

    <Style x:Key="SettingsGroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Margin" Value="0,20,0,10"/>
    </Style>

    <Style x:Key="SettingsSubHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Margin" Value="0,14,0,8"/>
    </Style>

    <Style x:Key="SettingsGroupDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource SettingsRowBorderBrush}"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <Style x:Key="TabHeaderButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="0,0,0,10"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- The Border is what makes the padding clickable. Without it the template was a
                         bare ContentPresenter, and an element with no Background is not hit-testable at
                         all: the target was the text's own glyphs and nothing else, so the padding that
                         looks like part of the tab did nothing. Transparent hit-tests and costs nothing
                         to draw. Padding moves onto the Border from the presenter's Margin, which is the
                         same geometry said the right way round. -->
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabUnderlineStyle" TargetType="Border">
        <Setter Property="Height" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
        <Setter Property="Margin" Value="0,-2,0,0"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <!-- Plain-text "select all / deselect all" toggle: a real Button (chrome, border,
         background) reads as a heavier action than it is next to a group label, so this
         uses a hyperlink look instead to match its actual weight. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small square icon button for a rule/row action (remove, reorder, ...). Two variants exist
         because their hover feedback genuinely differs: this one is background-only, used by the
         Startup Panel's tab-order/recent-files rows. -->
    <Style x:Key="RuleIconButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppIconFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same shape as RuleIconButton, but hover also tints the border/foreground accent-blue: used
         by the Hotkey blacklist and Index exclusion-rule rows. -->
    <Style x:Key="RuleIconButtonAccent" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppIconFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RuleTextBox" TargetType="TextBox" BasedOn="{StaticResource ThemedTextBox}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RuleBulkTextBox" TargetType="TextBox" BasedOn="{StaticResource RuleTextBox}">
        <Setter Property="Height" Value="132"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="AcceptsTab" Value="True"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppMonospaceFontFamily}"/>
    </Style>

    <!-- Reorder button with accent-colored hover feedback for quick-navigation rows. -->
    <Style x:Key="QuickNavIconButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppIconFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <pconv:ComponentTypeToBadgeBrushConverter x:Key="TypeToBrush"/>
    <conv:StringToVisibilityConverter x:Key="StringToVis"/>

    <!-- Shared editor template for process-name lists used by hotkeys and quick-panel workspaces. -->
    <DataTemplate x:Key="ProcessListRowTemplate">
        <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xEA18;" FontFamily="{DynamicResource AppIconFontFamily}" FontSize="14"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                           Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE70F;"
                            ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_EditTooltip]}"
                            Style="{StaticResource RuleIconButtonAccent}"
                            Command="{Binding DataContext.EditProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="&#xE74D;"
                            ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_RemoveTooltip]}"
                            Style="{StaticResource RuleIconButtonAccent}"
                            Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ProcessListEditorTemplate">
        <StackPanel>
            <settings:RunningProcessPicker Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_AddedList]}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Items.Count}" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
            </StackPanel>
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ProcessListRowTemplate}"/>
            </ScrollViewer>
            <Expander Foreground="{DynamicResource TextPrimary}" Margin="0,12,0,0" IsExpanded="{Binding IsManualEditorOpen, Mode=TwoWay}"
                      Header="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_ManualAndBulk]}">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_ProcessCardDesc]}"
                               Style="{StaticResource SettingsHintText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding AddProcessCommand}" Margin="8,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimarySettingsButton}">
                                    <Setter Property="Content" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_AddBtn]}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Content" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_ConfirmEdit]}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding CancelEditCommand}" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}" Margin="8,0,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <TextBox Style="{StaticResource RuleTextBox}" Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_AddBtn]}">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddProcessCommand}"/></TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <TextBlock Text="{Binding ManualError}" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_BulkLabel]}" Margin="0,12,0,6"/>
                    <TextBox Style="{StaticResource RuleBulkTextBox}" Text="{Binding BulkText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_BulkLabel]}"/>
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_ApplyBtn]}"
                            Style="{StaticResource SettingsButton}" Command="{Binding ApplyTextCommand}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
