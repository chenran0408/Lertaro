<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:glass="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Colors.xaml"/>
        <ResourceDictionary Source="../Tokens/Spacing.xaml"/>
        <ResourceDictionary Source="../Tokens/Motion.xaml"/>
        <ResourceDictionary Source="TextBox.xaml"/>
        <ResourceDictionary Source="Slider.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════ Modern Arc Spinner ═══════════ -->
    <Style x:Key="ModernSpinnerStyle" TargetType="{x:Type Control}">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="SpinnerGrid" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="SpinnerTransform" Angle="0"/>
                        </Grid.RenderTransform>
                        <!-- Background track -->
                        <Ellipse Stroke="{DynamicResource SpinnerTrackBrush}" StrokeThickness="2" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"/>
                        <!-- Spinning accent arc (StrokeDashArray is extremely smooth and looks high-end) -->
                        <Ellipse Stroke="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="2"
                                 StrokeDashArray="3 1"
                                 Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SpinnerStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SpinnerGrid"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1.0"
                                                         RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <!-- Stop the Forever animation when the spinner is hidden; otherwise its clock
                                 keeps ticking (and re-compositing the layered window) forever, burning ~1%
                                 CPU invisibly after the first search/loading. -->
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinnerStoryboard"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ Themed ProgressBar (determinate only, the only current usage) ═══════════ -->
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="{DynamicResource LiquidControlFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidControlEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource LiquidControlAccent}"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border x:Name="PART_Track" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="True">
                        <Grid HorizontalAlignment="Left">
                            <Border x:Name="PART_Indicator" CornerRadius="4"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ Modern Fluent CheckBox Style ═══════════ -->
    <Style x:Key="ThemedCheckBox" TargetType="{x:Type CheckBox}">
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"/>
            </Style>
        </Style.Resources>
        <Setter Property="Foreground">
            <Setter.Value>
                <Binding Path="ForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                         FallbackValue="{StaticResource LiquidControlText}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                            <glass:PhoneBorder x:Name="Border"
                                    Width="20" Height="20"
                                    CornerRadius="7"
                                    Background="{DynamicResource LiquidControlFill}"
                                    BorderBrush="{DynamicResource LiquidControlEdge}"
                                    BorderThickness="1"/>
                            <TextBlock x:Name="CheckMark"
                                       Text="✓"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LiquidControlText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#CC1684FF"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#CC91CAFF"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#CC91CAFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">


                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource ThemedCheckBox}"/>

    <!-- ═══════════ Modern Fluent RadioButton Style ═══════════ -->
    <Style x:Key="ThemedRadioButton" TargetType="{x:Type RadioButton}">
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </Style>
        </Style.Resources>
        <Setter Property="Foreground">
            <Setter.Value>
                <Binding Path="ForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                         FallbackValue="{StaticResource LiquidControlText}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                            <glass:PhoneBorder x:Name="OuterBorder"
                                    Width="20" Height="20"
                                    CornerRadius="8"
                                    Background="{DynamicResource LiquidControlFill}"
                                    BorderBrush="{DynamicResource LiquidControlEdge}"
                                    BorderThickness="1"/>
                            <Ellipse x:Name="CheckDot"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource LiquidControlText}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource LiquidControlAccent}"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource LiquidControlAccent}"/>
                            <Setter TargetName="CheckDot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource LiquidControlAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource ThemedRadioButton}"/>

    <!-- ═══════════ Themed ToolTip ═══════════ -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource LiquidControlPopup}"/>
        <Setter Property="Foreground" Value="{DynamicResource LiquidControlText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidControlEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <glass:PhoneBorder Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </glass:PhoneBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
