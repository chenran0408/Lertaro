<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:glass="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Colors.xaml"/>
        <ResourceDictionary Source="../Tokens/Spacing.xaml"/>
        <ResourceDictionary Source="../Tokens/Motion.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Default Button follows GlassDesk 1.4.0 LiquidGlassTheme.xaml. -->
    <Style TargetType="Button">
        <Setter Property="Foreground">
            <Setter.Value>
                <Binding Path="ForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                         FallbackValue="{StaticResource LiquidControlText}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource LiquidControlFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidControlEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <glass:PhoneBorder x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="13" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </glass:PhoneBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LiquidControlHover}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LiquidControlEdgeActive}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.76"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF66B5FF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings action buttons keep their existing footprint and use the shared GlassDesk chrome. -->
    <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="92"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="PrimarySettingsButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}"/>
</ResourceDictionary>
