<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Control surface values follow GlassDesk 1.4.0's LiquidGlassTheme.xaml. The window material
         remains responsible for backdrop sampling; these are only the foreground control layers. -->
    <LinearGradientBrush x:Key="LiquidControlFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#30FFFFFF" Offset="0"/>
        <GradientStop Color="#18FFFFFF" Offset="0.45"/>
        <GradientStop Color="#10FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidControlHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#50FFFFFF" Offset="0"/>
        <GradientStop Color="#28FFFFFF" Offset="0.55"/>
        <GradientStop Color="#1CFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LiquidControlEdge" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="LiquidControlEdgeActive" Color="#BFFFFFFF"/>
    <SolidColorBrush x:Key="LiquidControlText" Color="#F7F7FA"/>
    <SolidColorBrush x:Key="LiquidControlMuted" Color="#E4E6EA"/>
    <SolidColorBrush x:Key="LiquidControlPopup" Color="#EC22242B"/>
    <SolidColorBrush x:Key="LiquidControlAccent" Color="#FF1684FF"/>

    <!-- GlassWindow exposes the per-window GlassPalette brushes, including its light/dark mapping. -->
    <Style x:Key="GlassTextPrimary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="{DynamicResource AppUiFontWeight}"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <Binding Path="ForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                         FallbackValue="{StaticResource LiquidControlText}"/>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassTextSecondary" TargetType="TextBlock" BasedOn="{StaticResource GlassTextPrimary}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <Binding Path="SecondaryForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                         FallbackValue="{StaticResource LiquidControlMuted}"/>
            </Setter.Value>
        </Setter>
    </Style>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
</ResourceDictionary>
