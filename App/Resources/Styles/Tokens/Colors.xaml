<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keep legacy style keys theme-aware while existing views migrate to the shared palette. -->
    <Style x:Key="GlassTextPrimary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="{DynamicResource AppUiFontWeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="GlassTextSecondary" TargetType="TextBlock" BasedOn="{StaticResource GlassTextPrimary}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
</ResourceDictionary>
