<UserControl x:Class="Lertaro.App.Views.Settings.FavoritesSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             xmlns:ctrl="clr-namespace:Lertaro.App.Views.Controls"
             xmlns:helpers="clr-namespace:Lertaro.App.Helpers.Visuals"
             xmlns:settings="clr-namespace:Lertaro.App.Views.Settings"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PathListIconButton" TargetType="Button" BasedOn="{StaticResource RuleIconButton}">
                <Setter Property="Width" Value="31"/>
                <Setter Property="Height" Value="31"/>
                <Setter Property="Margin" Value="5,0,0,0"/>
            </Style>
            <DataTemplate x:Key="PathListItemTemplate">
                <Border Style="{StaticResource SettingsRow}" Padding="0,9">
                    <Grid>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button Content="&#xE74A;" Style="{StaticResource PathListIconButton}"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_MoveUpTooltip]}"
                                        AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Content="&#xE74B;" Style="{StaticResource PathListIconButton}"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_MoveDownTooltip]}"
                                        AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Content="&#xE70F;" Style="{StaticResource PathListIconButton}"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_EditTooltip]}"
                                        AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Content="&#xE74D;" Style="{StaticResource PathListIconButton}"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_RemoveTooltip]}"
                                        AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <Border Width="22" Height="30" Background="Transparent" Cursor="SizeNS" VerticalAlignment="Center"
        helpers:DragReorder.IsHandle="True"
        Visibility="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
    <TextBlock Text="&#xE76F;" FontFamily="{DynamicResource AppIconFontFamily}"
               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
</Border>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"
                                           ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="28,3,0,0">
                                <ctrl:HotkeyRecorderControl DockPanel.Dock="Right" Width="155" Height="28" Margin="10,0,0,0"
                                    Value="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}" RequireModifier="True"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_HotkeyTooltip]}"
                                    AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_FieldHotkey]}"/>
                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="13"/>
                            </DockPanel>
                            <TextBlock Text="{Binding HotkeyHint}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                                       Margin="28,4,0,0" Visibility="{Binding HotkeyHint, Converter={StaticResource StringToVis}}"/>
                        </StackPanel>
                        <Border Background="{DynamicResource ControlBackground}" CornerRadius="{DynamicResource CornerRadiusControl}" Padding="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <settings:PathEntryEditor EntryName="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    EntryPath="{Binding EditPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    BrowseFolderCommand="{Binding DataContext.BrowseEditFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    BrowseFileCommand="{Binding DataContext.BrowseEditFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}" Style="{StaticResource SettingsButton}" MinWidth="0"
        Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[PathEntry_Save]}" Style="{StaticResource PrimarySettingsButton}" MinWidth="0"
        Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Style="{StaticResource SettingsSectionTitle}" 
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_Title]}"/>

            <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock x:Name="RowListTitle" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_ListTitle]}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,9">
                            <TextBox x:Name="PathFilterBox" MinHeight="34" Padding="10,0"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[PathList_Filter]}"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[PathList_Filter]}" Margin="10,0,5,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Expander x:Name="AddEntryForm" IsExpanded="{Binding IsAddFormOpen, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock x:Name="RowAddCardTitle" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_AddCardTitle]}" FontWeight="SemiBold"/>
                            </Expander.Header>
                            <StackPanel Margin="0,10,0,4">
                                <settings:PathEntryEditor x:Name="AddFavoriteEditor" EntryName="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    EntryPath="{Binding NewPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    BrowseFolderCommand="{Binding BrowseFolderCommand}" BrowseFileCommand="{Binding BrowseFileCommand}"/>
                                <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_AddPresetTooltip]}"
                                        Style="{StaticResource SettingsButton}" Click="OpenPresetMenu_Click" MinWidth="0">
                                    <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
                                </Button>
                                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_AddBtn]}" Style="{StaticResource PrimarySettingsButton}"
                                            Command="{Binding AddCommand}" MinWidth="0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="RowFieldHotkey" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_HotkeyTooltip]}"
                                   Style="{StaticResource SettingsHintText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="PathItemsList" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PathListItemTemplate}"
                                      helpers:DragReorder.IsEnabled="True"/>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[PathList_Empty]}" Margin="0,12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=PathItemsList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_ClearList]}" Style="{StaticResource SettingsButton}"
                                HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}"
                                Command="{Binding ClearCommand}"/>
                    </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
