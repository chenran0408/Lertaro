<UserControl x:Class="Lertaro.App.Views.Settings.TaskbarSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             xmlns:plugins="clr-namespace:Lertaro.App.Views.Settings.Plugins">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{DynamicResource SettingsGroupTitle}" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_TaskbarTitle]}"/>
        <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
                <TextBlock Style="{DynamicResource SettingsHintText}" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_TaskbarHint]}"/>
                <Expander x:Name="TaskbarOptions" Margin="0,8,0,0" Expanded="OptionsExpanded"
                          Foreground="{DynamicResource TextPrimary}"
                          Header="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_TaskbarOptions]}">
                <StackPanel>
                <TextBlock x:Name="Unavailable" Style="{DynamicResource SettingsHintText}" Margin="0,8,0,0" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_TaskbarUnavailable]}"/>
                <StackPanel x:Name="QuickTools" Visibility="Collapsed" Margin="0,12,0,8">
                    <WrapPanel>
                        <Button Click="ChooseColor" Style="{StaticResource SettingsButton}" Margin="0,0,8,0" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Background_FirstColor]}"/>
                        <Button x:Name="PreviewButton" Click="Preview" Style="{StaticResource SettingsButton}" Margin="0,0,8,0" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_TaskbarPreview]}"/>
                        <Button Click="UndoPreview" Style="{StaticResource SettingsButton}" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Background_Undo]}"/>
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextPrimary}" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_TaskbarOpacity]}"/>
                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" AutoToolTipPlacement="TopLeft"/>
                    <TextBlock x:Name="PreviewStatus" Style="{DynamicResource SettingsHintText}" TextWrapping="Wrap"/>
                </StackPanel>
                <plugins:PluginConfigSection x:Name="Fields" Visibility="Collapsed"/>
                </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
