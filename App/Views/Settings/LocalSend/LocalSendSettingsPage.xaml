<UserControl x:Class="Lertaro.App.Views.Settings.LocalSend.LocalSendSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             xmlns:local="clr-namespace:Lertaro.App.Views.Settings.LocalSend"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Style="{StaticResource SettingsSectionTitle}"
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Title]}"/>

            <local:LocalSendSendCard x:Name="SendEntry" Margin="0,0,0,15"/>
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <!-- Status Indicator Row -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_StatusTitle]}"
                                       FontSize="14" FontWeight="Medium" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SuccessBadgeBackground}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServiceRunning}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource ControlDisabledBackground}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServiceRunning}" Value="False">
                                                    <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_StatusRunning]}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServiceRunning}" Value="False">
                                                    <Setter Property="Text" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_StatusStopped]}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,0,0,12"/>

                    <DockPanel x:Name="RowLocalSendEnable" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Enable]}"
                                       FontSize="14" FontWeight="Medium" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Enable]}"
                                  ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_EnableDesc]}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,0,0,12"/>

                    <Grid x:Name="RowLocalSendDeviceAlias" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_DeviceAlias]}"
                                           FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                                <Border Margin="6,0,0,0" Padding="5,1,5,1" CornerRadius="3"
                                        Background="{DynamicResource ControlBackground}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeviceHashtag}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource SettingsTextBox}"
                                     AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_DeviceAlias]}"
                                     Text="{Binding DeviceAlias, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Command="{Binding RandomizeAliasCommand}"
                                    AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_RandomAlias]}"
                                    ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}"
                                    Style="{StaticResource SettingsButton}" Content="&#xE72C;" FontFamily="{DynamicResource AppIconFontFamily}"
                                    MinWidth="32" Height="32" Padding="0" Margin="6,0,0,0"/>
                        </Grid>
                    </Grid>

                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Receiving]}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>
                    <Grid x:Name="RowLocalSendReceivePin" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_ReceivePin]}"
                                       FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_ReceivePin]}"
                                 ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_ReceivePinDesc]}" Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding ReceivePin, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid x:Name="RowLocalSendQuickSave" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_QuickSave]}"
                                       FontSize="14" FontWeight="Medium" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_QuickSaveDesc]}"
                                       TextWrapping="Wrap" FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_QuickSave]}"
                                 ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_QuickSaveDesc]}" IsChecked="{Binding QuickSave}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid x:Name="RowLocalSendDownloadDir" Margin="0,0,0,4">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QuickSave}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_DownloadDir]}"
                                       FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                            <TextBlock Text="{Binding DownloadDirectoryDisplay}" FontSize="14"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SettingsButton}"
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Browse]}"
                                Command="{Binding SelectDownloadDirectoryCommand}" Padding="12,0" Height="30"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Connection]}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>
                    <Grid x:Name="RowLocalSendPort" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Port]}"
                                       FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Port]}"
                                 ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_PortDesc]}" Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid x:Name="RowLocalSendDiscoveryTimeout" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_DiscoveryTimeout]}"
                                       FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_DiscoveryTimeout]}"
                                 ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_DiscoveryTimeoutDesc]}" Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding DiscoveryTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <DockPanel x:Name="RowLocalSendEnableHttps" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_EnableHttps]}"
                                       FontSize="14" FontWeight="Medium" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_EnableHttps]}"
                                 ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_EnableHttpsDesc]}" IsChecked="{Binding EnableHttps}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DockPanel x:Name="RowLocalSendCreateChecksums" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_CreateChecksums]}"
                                       FontSize="14" FontWeight="Medium" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_CreateChecksums]}"
                                 ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_CreateChecksumsDesc]}" IsChecked="{Binding CreateChecksums}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DockPanel x:Name="RowLocalSendVerifyChecksums" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_VerifyChecksums]}"
                                       FontSize="14" FontWeight="Medium" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_VerifyChecksums]}"
                                 ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_VerifyChecksumsDesc]}" IsChecked="{Binding VerifyChecksums}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
