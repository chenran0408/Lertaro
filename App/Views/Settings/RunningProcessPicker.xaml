<UserControl x:Class="Lertaro.App.Views.Settings.RunningProcessPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Controls/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Shared picker keeps the process-list editor template small. All state belongs to its editor. -->
    <Expander Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}" IsExpanded="{Binding IsProcessPickerOpen, Mode=TwoWay}"
              Header="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_SelectRunning]}">
        <StackPanel Margin="0,10,0,0">
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_RunningHint]}"
                       Style="{DynamicResource SettingsHintText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Command="{Binding RefreshProcessesCommand}"
                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_RefreshProcesses]}"
                        Style="{DynamicResource SettingsButton}" Margin="8,0,0,0"/>
                <Grid>
                <TextBox Text="{Binding ProcessSearch, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource RuleTextBox}"
                         ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_ProcessSearch]}"
                         AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_ProcessSearch]}"/>
                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_ProcessSearch]}"
                           Margin="10,0" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding ProcessSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                </Grid>
            </DockPanel>
            <CheckBox IsChecked="{Binding ShowAllProcesses}" Margin="0,0,0,8"
                      Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_ShowAllProcesses]}"/>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_LoadingProcesses]}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoadingProcesses}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding ProcessLoadError}" TextWrapping="Wrap" Foreground="{DynamicResource AccentColor}"/>
            <ListBox ItemsSource="{Binding RunningProcesses}" MaxHeight="220" MinHeight="80"
                     Background="{StaticResource LiquidControlFill}" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"
                     BorderBrush="{StaticResource LiquidControlEdge}" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Foreground"><Setter.Value><Binding Path="ForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" FallbackValue="{StaticResource LiquidControlText}"/></Setter.Value></Setter>
                        <Setter Property="Template"><Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ProcessBackground" Background="Transparent" CornerRadius="4" Margin="2" Padding="2">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ProcessBackground" Property="Background" Value="{DynamicResource LiquidControlHover}"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ProcessBackground" Property="Background" Value="{DynamicResource LiquidControlHover}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="6" HorizontalContentAlignment="Stretch">
                            <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource ThemedCheckBox}"><Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdded}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            </Style.Triggers></Style></CheckBox.Style>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_AlreadyAdded]}" Margin="10,0,0,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsAdded}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                </DockPanel>
                                <TextBlock Text="{Binding WindowTitle}" FontSize="14" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding WindowTitle}" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_NoMatchingProcesses]}"
                       TextWrapping="Wrap" Margin="0,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RunningProcesses.Count}" Value="0"/>
                                    <Condition Binding="{Binding IsLoadingProcesses}" Value="False"/>
                                    <Condition Binding="{Binding ProcessLoadError}" Value=""/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Command="{Binding AddSelectedProcessesCommand}"
                        Style="{DynamicResource PrimarySettingsButton}"
                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_AddSelected]}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_SelectedCount]}"/>
                    <TextBlock Text="{Binding SelectedRunningCount}" Margin="6,0,0,0"/>
                    <Button Command="{Binding ClearProcessSelectionCommand}" Style="{DynamicResource LinkButton}" Margin="10,0,0,0"
                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_ClearSelection]}"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Expander>
</UserControl>
