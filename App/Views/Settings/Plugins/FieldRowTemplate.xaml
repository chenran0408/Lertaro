<ResourceDictionary x:Class="Lertaro.App.Views.Settings.Plugins.PluginConfigFieldRowTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:Lertaro.App.Services"
                    xmlns:vm="clr-namespace:Lertaro.App.ViewModels.Settings.Plugins"
                    xmlns:helpers="clr-namespace:Lertaro.App.Helpers.Visuals"
                    xmlns:ctrl="clr-namespace:Lertaro.App.Views.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Templates.xaml"/>
        <ResourceDictionary Source="CustomControlStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Implicit DataTemplate for recursive/nested plugin config fields rendering -->
    <DataTemplate DataType="{x:Type vm:PluginConfigFieldViewModel}">
        <ctrl:InlineEditorHost AutoExpandEnabled="{Binding SupportsInlineEditing}"
                               EditorTemplate="{StaticResource PluginInlineEditorTemplate}"
                               EditCompleted="InlineEditorHost_EditCompleted">
        <ctrl:InlineEditorHost.NormalContent>
        <Border Style="{StaticResource SettingsRow}" Padding="8,6" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FieldEditor"/>
                </Grid.ColumnDefinitions>

                <!-- Label & Description for simple inputs -->
                <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,0"
                            Visibility="{Binding IsSimpleField, Converter={StaticResource BoolToVis}}">
                    <ContentControl Content="{Binding}" Focusable="False" ContentTemplate="{StaticResource PluginFieldHeading}"/>
                    <!-- Two features answering to one trigger word: both answer to it and the file search
                         strips the word once, so nothing here is silently wrong, it is just ambiguous. Named
                         at the field where the collision is being created, and never enforced. -->
                    <TextBlock Text="{Binding ConflictWarning}" FontSize="14" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,2,0,0" Visibility="{Binding ConflictWarning, Converter={StaticResource StringToVis}}"/>
                </StackPanel>

                <!-- Custom Control layout for embedded plugin host panels -->
                <ContentControl Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                                Content="{Binding CustomControl}" HorizontalAlignment="Stretch" Margin="0,4"
                                TextElement.Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"
                                Visibility="{Binding IsCustomControl, Converter={StaticResource BoolToVis}}"/>

                <!-- Field Controls for simple inputs -->
                <ContentControl Content="{Binding}" VerticalAlignment="Center" Focusable="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl" BasedOn="{StaticResource FieldValueEditorStyle}">
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="Grid.Row" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UsesWideEditor}" Value="True">
                                    <Setter Property="Grid.Column" Value="0"/>
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Margin" Value="0,6,0,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <!-- Object layout -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="4,4,4,4"
                            Visibility="{Binding IsObject, Converter={StaticResource BoolToVis}}">
                    <ContentControl Content="{Binding}" Focusable="False" Margin="0,0,0,6"
                                    ContentTemplate="{StaticResource PluginFieldHeading}"/>

                    <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1,0,0,0" Margin="8,0,0,0" Padding="12,0,0,0">
                        <!-- Collapsed layouts still create children. Only the matching layout may
                             host them: a plugin's CustomControl can have only one visual parent. -->
                        <ItemsControl>
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsObject}" Value="True">
                                            <Setter Property="ItemsSource" Value="{Binding Children}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Group layout -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="4,4,4,4"
                            Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}">
                    <ContentControl Content="{Binding}" Focusable="False" Margin="0,0,0,6"
                                    ContentTemplate="{StaticResource PluginFieldHeading}"/>

                    <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1,0,0,0" Margin="8,0,0,0" Padding="12,0,0,0">
                        <ItemsControl>
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                            <Setter Property="ItemsSource" Value="{Binding Children}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Array layout: shared heading, then either the object-array table or the
                     scalar-array list below it. -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="4,4,4,4"
                            Visibility="{Binding IsArray, Converter={StaticResource BoolToVis}}">
                    <ContentControl Content="{Binding}" Focusable="False" ContentTemplate="{StaticResource PluginFieldHeading}"/>

                    <Grid Margin="0,6,0,0" SizeChanged="ArrayLayout_SizeChanged"
                          Visibility="{Binding IsObjectArray, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <Button Click="ChoosePreset_Click" Style="{StaticResource SettingsButton}" Height="30" MinWidth="0"
                                        Margin="0,0,6,0" AutomationProperties.AutomationId="ChoosePreset"
                                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_EntryPresets]}"
                                        Visibility="{Binding HasEntryPresets, Converter={StaticResource BoolToVis}}"/>
                                <Button Style="{StaticResource SettingsButton}" Command="{Binding AddCommand}" Margin="0,0,4,0" MinWidth="48" Height="32"
                                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Add]}"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Add]}"/>
                                <Button Style="{StaticResource ArrayHeaderDuplicateButton}"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Duplicate]}"/>
                                <Button Style="{StaticResource ArrayHeaderAddButton}" Command="{x:Null}" Content="&#xE8B5;"
                                        Click="ImportEntry_Click" Visibility="{Binding SupportsEntryTransfer, Converter={StaticResource BoolToVis}}"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_EntryImport]}"
                                        AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_EntryImport]}"/>
                                <Button Style="{StaticResource ArrayHeaderAddButton}" Command="{x:Null}" Content="&#xEDE1;"
                                        Click="ExportEntry_Click" Visibility="{Binding SupportsEntryTransfer, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding CanExportEntry}"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_EntryExport]}"
                                        AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_EntryExport]}"/>
                            </WrapPanel>
                            <ListBox Grid.Row="1" MaxHeight="220" AutomationProperties.Name="{Binding Label}" ItemsSource="{Binding ArrayItems}" SelectedItem="{Binding SelectedArrayItem, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.CanContentScroll="False"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource ArrayMasterListItemStyle}"
                                     SelectionChanged="ArrayMasterList_SelectionChanged"
                                     helpers:DragReorder.IsEnabled="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Drag handle: mouse-drag shortcut for reordering (see DragReorder on the
                                                 ListBox above), same six-dot grip used by every other reorderable list
                                                 in Settings, scaled down to fit this narrower master-list column. -->
                                            <Grid Grid.Column="0" Width="14" Height="22" Margin="0,0,6,0" Background="Transparent"
                                                  Cursor="SizeAll" helpers:DragReorder.IsHandle="True">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                                <Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                                <Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                                <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                                <Ellipse Grid.Row="2" Grid.Column="0" Width="2" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                                <Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                            </Grid>

                                            <Border Grid.Column="1" Width="22" Height="22" Margin="0,0,8,0" CornerRadius="4"
                                                    Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                    Visibility="{Binding IconField, Converter={StaticResource NullToVis}}">
                                                <Path Data="{Binding IconField.Value}" Fill="{DynamicResource DefaultPluginIconColor}" Width="11" Height="11" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayTitle, Converter={StaticResource EmptyOrPlaceholder}}" FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                        CornerRadius="4" Padding="5,0,5,1" Margin="0,3,0,0" HorizontalAlignment="Left"
                                                        Visibility="{Binding BadgeField, Converter={StaticResource BadgeFieldToVis}}">
                                                    <TextBlock Text="{Binding BadgeField.Value}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BadgeText}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource ArrayRowMoveUpButton}"
                                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_MoveUpTooltip]}"/>
                                                <Button Style="{StaticResource ArrayRowMoveDownButton}"
                                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_MoveDownTooltip]}"/>
                                                <Button Style="{StaticResource ArrayRowDeleteButton}"
                                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Delete]}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Border Grid.Row="1" Margin="0,10,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource ControlBorderBrush}" Visibility="{Binding SelectedArrayItem, Converter={StaticResource NullToVis}}"
                                Loaded="ArrayDetailPanel_Loaded" SizeChanged="ArrayDetailPanel_SizeChanged">
                            <StackPanel DataContext="{Binding SelectedArrayItem}">
                                <ItemsControl ItemsSource="{Binding BasicFields}" ItemTemplate="{StaticResource ArrayDetailFieldTemplate}"/>
                                <Expander AutomationProperties.AutomationId="AdvancedEntryFields"
                                          Visibility="{Binding HasAdvancedFields, Converter={StaticResource BoolToVis}}"
                                          Header="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_EntryAdvanced]}">
                                    <ItemsControl ItemsSource="{Binding AdvancedFields}" ItemTemplate="{StaticResource ArrayDetailFieldTemplate}"/>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Scalar-array list: a single value column, no header needed -->
                    <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1,0,0,0" Margin="8,0,0,0" Padding="12,0,0,0"
                            Visibility="{Binding IsScalarArray, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding ArrayItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="0,4" Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl Content="{Binding SimpleValueViewModel}" VerticalAlignment="Center" Focusable="False"
                                                                 Style="{StaticResource FieldValueEditorStyle}"/>
                                                <Button Style="{StaticResource ArrayRowDeleteButton}"
                                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Delete]}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Command="{Binding AddCommand}" Style="{StaticResource PrimarySettingsButton}" MinHeight="32" MinWidth="80" Padding="8,0" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Add]}" FontSize="14" Cursor="Hand" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        </ctrl:InlineEditorHost.NormalContent>
        </ctrl:InlineEditorHost>
    </DataTemplate>
</ResourceDictionary>
