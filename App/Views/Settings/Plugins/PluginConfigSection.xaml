<UserControl x:Class="Lertaro.App.Views.Settings.Plugins.PluginConfigSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             xmlns:conv="clr-namespace:Lertaro.App.Converters"
             xmlns:local="clr-namespace:Lertaro.App.Views.Settings.Plugins"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="620">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
                <ResourceDictionary Source="FieldRowTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- RefEquals is not declared here: FieldRowTemplate.xaml above merges Templates.xaml, which
                 already registers it under that key, and a second declaration would be a second instance
                 of the same stateless converter. -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Grid.IsSharedSizeScope="True" Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Visibility="{Binding HasMultipleConfigGroups, Converter={StaticResource BoolToVis}}">
            <ItemsControl Margin="0,4,0,4" ItemsSource="{Binding ConfigGroups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,18,4">
                            <Button Content="{Binding Label}"
                                    Command="{Binding DataContext.SelectConfigGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource RefEquals}">
                                                        <Binding/>
                                                        <Binding Path="DataContext.SelectedConfigGroup" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource RefEquals}">
                                                        <Binding/>
                                                        <Binding Path="DataContext.SelectedConfigGroup" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,0,0,6"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl>
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMultipleConfigGroups}" Value="True">
                                    <Setter Property="ItemsSource" Value="{Binding NonGroupConfigFields}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
                <ItemsControl>
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemsSource" Value="{Binding FlatConfigFields}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMultipleConfigGroups}" Value="True">
                                    <Setter Property="ItemsSource" Value="{Binding ActiveConfigGroupChildren}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
