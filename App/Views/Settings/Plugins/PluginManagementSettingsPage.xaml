<UserControl x:Class="Lertaro.App.Views.Settings.Plugins.PluginManagementSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             xmlns:conv="clr-namespace:Lertaro.App.Converters"
             xmlns:local="clr-namespace:Lertaro.App.Views.Settings.Plugins">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InverseVis" Invert="True"/>
            <Style x:Key="PluginListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItemStyle}">
                <Setter Property="Padding" Value="8,8"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Visibility="{Binding IsConfigurationDirectory, Converter={StaticResource InverseVis}}" Margin="0,0,0,10" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource SettingsButton}" MinWidth="0" Height="30"
                    Content="{Binding HostSdkVersionLabel}" Click="SdkGuide_Click"
                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_DevGuideTooltip]}"
                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <WrapPanel>
                <Button x:Name="TabManagement" Command="{Binding ShowPluginManagementCommand}"
                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_TabManagement]}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
                            <Setter Property="Margin" Value="0,0,6,4"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="Height" Value="30"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPluginManagementTab}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SidebarSelected}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="TabRuntimeStatus" Command="{Binding ShowRuntimeStatusCommand}"
                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_TabRuntimeStatus]}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
                            <Setter Property="Margin" Value="0,0,6,4"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="Height" Value="30"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRuntimeStatusTab}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SidebarSelected}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource SettingsCard}" Padding="10,7" Margin="0,0,0,8"
                Visibility="{Binding DataContext.RequiresPluginRestart, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_RestartPending]}"
                       TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>

        <Grid Grid.Row="2" Visibility="{Binding IsPluginManagementTab, Converter={StaticResource BoolToVis}}">
            <Grid x:Name="ListPane" Visibility="{Binding IsPluginDetailsOpen, Converter={StaticResource InverseVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="1" x:Name="PluginCategoryFilter" MinWidth="120" MaxWidth="220" Margin="8,0,0,0"
                              Style="{StaticResource SettingsComboBox}" ItemsSource="{Binding CategoryChoices}" DisplayMemberPath="Name"
                              SelectedValuePath="Key" SelectedValue="{Binding SelectedCategory}"
                              Visibility="{Binding IsConfigurationDirectory, Converter={StaticResource BoolToVis}}"
                              AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_CategoryFilter]}"/>
                    <TextBox x:Name="PluginSearchBox" PreviewKeyDown="PluginSearchBox_PreviewKeyDown" Height="34" Padding="9,0"
                             AutomationProperties.Name="{Binding PluginSearchLabel}"
                             Text="{Binding InstalledPluginSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Margin="10,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                               Text="{Binding PluginSearchLabel}"
                               IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InstalledPluginSearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <WrapPanel Visibility="{Binding IsConfigurationDirectory, Converter={StaticResource InverseVis}}" Grid.Row="1" Margin="0,0,0,5">
                    <ComboBox x:Name="PluginStatusFilter" Style="{StaticResource SettingsComboBox}" MinWidth="90" Margin="0,0,6,4"
                              SelectedValuePath="Tag" SelectedValue="{Binding InstalledPluginFilter}"
                              AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_FilterStatus]}">
                        <ComboBoxItem Tag="All" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_FilterAll]}"/>
                        <ComboBoxItem Tag="Configurable" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_FilterConfigurable]}"/>
                        <ComboBoxItem Tag="Enabled" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_FilterEnabled]}"/>
                        <ComboBoxItem Tag="Disabled" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_FilterDisabled]}"/>
                    </ComboBox>
                    <Button Style="{StaticResource SettingsButton}" MinWidth="0" Height="30" Margin="0,0,0,4"
                            Click="PluginColumnHeader_Click" Content="{Binding PluginSortLabel}"
                            AutomationProperties.Name="{Binding PluginSortLabel}"/>
                </WrapPanel>

                <Border Grid.Row="2" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusControl}" Padding="3">
                    <Grid>
                        <ListBox x:Name="PluginsList" ItemsSource="{Binding VisiblePlugins}"
                                 SelectedItem="{Binding SelectedPlugin, Mode=OneWay}"
                                 ItemContainerStyle="{StaticResource PluginListItemStyle}" SelectionChanged="PluginsList_SelectionChanged"
                                 PreviewKeyDown="PluginsList_PreviewKeyDown" MouseLeftButtonUp="PluginsList_MouseLeftButtonUp"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                 VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.GroupStyle>
                                <GroupStyle HidesIfEmpty="True">
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Margin="10,12,8,4" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding Name}">
                                        <Border Background="{DynamicResource ContentBg}" CornerRadius="{DynamicResource CornerRadiusControl}"
                                                Width="32" Height="32" Margin="0,0,8,0">
                                            <TextBlock Text="&#xE71D;" FontFamily="{DynamicResource AppIconFontFamily}" FontSize="15"
                                                       Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" VerticalAlignment="Center" Margin="12,0,10,0"
                                                   FontFamily="{DynamicResource AppIconFontFamily}" Foreground="{DynamicResource TextSecondary}"
                                                   Visibility="{Binding DataContext.IsConfigurationDirectory, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    Visibility="{Binding DataContext.IsConfigurationDirectory, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseVis}}">
                                            <Button Style="{StaticResource SettingsButton}"
                                                    AutomationProperties.AutomationId="ConfigurePluginButton" Click="OpenPlugin_Click"
                                                    Visibility="{Binding HasConfigFields, Converter={StaticResource BoolToVis}}"
                                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Configure]}"
                                                    VerticalAlignment="Center" Margin="12,0,4,0"/>
                                            <Button Style="{StaticResource SettingsButton}"
                                                    AutomationProperties.AutomationId="PluginDetailsButton" Click="OpenPlugin_Click"
                                                    Visibility="{Binding HasConfigFields, Converter={StaticResource InverseVis}}"
                                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_TabDetails]}"
                                                    VerticalAlignment="Center" Margin="12,0,4,0"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <DockPanel Margin="0,3,0,0"
                                                       Visibility="{Binding DataContext.IsConfigurationDirectory, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseVis}}">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Version, StringFormat='v{0}'}"
                                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0"/>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_FilterEnabled]}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFullyDisabled}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_FilterDisabled]}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="12" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Text" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_NoMatches]}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=PluginsList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Text" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_NoPlugins]}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="DetailsPane" Visibility="{Binding IsPluginDetailsOpen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="BackToPluginsButton" HorizontalAlignment="Left" Margin="0,0,0,8"
                        Style="{StaticResource SettingsButton}" Click="BackToPlugins_Click"
                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_BackToList]}"/>
                <local:PluginCard x:Name="SelectedPluginCard" Grid.Row="1" DataContext="{Binding SelectedPlugin}" Focusable="False"/>
            </Grid>
        </Grid>

        <local:PluginRuntimeStatusView Grid.Row="2" Visibility="{Binding IsRuntimeStatusTab, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
