<UserControl x:Class="Lertaro.App.Views.Settings.QuickLaunch.QuickLaunchSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             xmlns:helpers="clr-namespace:Lertaro.App.Helpers.Visuals"
             xmlns:settings="clr-namespace:Lertaro.App.Views.Settings">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PathListIconButton" TargetType="Button" BasedOn="{StaticResource RuleIconButton}">
                <Setter Property="Width" Value="31"/>
                <Setter Property="Height" Value="31"/>
                <Setter Property="Margin" Value="5,0,0,0"/>
            </Style>
            <DataTemplate x:Key="PathListItemTemplate">
                <Border Style="{StaticResource SettingsRow}" Padding="0,9">
                    <Grid>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button Content="&#xE74A;" Style="{StaticResource PathListIconButton}"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_MoveUpTooltip]}"
                                        AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Content="&#xE74B;" Style="{StaticResource PathListIconButton}"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_MoveDownTooltip]}"
                                        AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Content="&#xE70F;" Style="{StaticResource PathListIconButton}"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_EditTooltip]}"
                                        AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Content="&#xE74D;" Style="{StaticResource PathListIconButton}"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_RemoveTooltip]}"
                                        AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <Border Width="22" Height="30" Background="Transparent" Cursor="SizeNS" VerticalAlignment="Center"
        helpers:DragReorder.IsHandle="True"
        Visibility="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
    <TextBlock Text="&#xE76F;" FontFamily="{DynamicResource AppIconFontFamily}"
               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
</Border>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"
                                           ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="28,3,0,0">
                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="13"/>
                            </DockPanel>
                        </StackPanel>
                        <Border Background="{DynamicResource ControlBackground}" CornerRadius="{DynamicResource CornerRadiusControl}" Padding="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <settings:PathEntryEditor x:Name="EditingPath" EntryName="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    EntryPath="{Binding EditPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    BrowseFolderCommand="{Binding DataContext.BrowseEditFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    BrowseFileCommand="{Binding DataContext.BrowseEditFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasPathError, Converter={StaticResource BoolToVis}}"
                                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[PathEntry_InvalidOrDuplicate]}"/>
                                <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}" Style="{StaticResource SettingsButton}" MinWidth="0"
        Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[PathEntry_Save]}" Style="{StaticResource PrimarySettingsButton}" MinWidth="0"
        Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_Title]}"/>
            <WrapPanel Margin="0,10,0,8">
                <CheckBox x:Name="RowQuickLaunchEnabled" Margin="0,0,18,6" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_Enabled]}"
                          IsChecked="{Binding IsEnabled}" FontSize="14"/>
                <CheckBox x:Name="RowQuickLaunchShowShortcutBadges" Margin="0,0,0,6" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_ShowShortcutBadges]}"
                          IsChecked="{Binding ShowShortcutBadges}" FontSize="14"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,6">
                <StackPanel>
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_ItemsTitle]}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Items">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Items">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Items">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
                <StackPanel Margin="18,0,0,0">
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_SourceTitle]}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Sources">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Sources">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Sources">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </WrapPanel>
            <Grid VerticalAlignment="Top">
                <Border VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Items">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock x:Name="RowQuickLaunchItemsTitle" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_ItemsTitle]}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,9">
                            <TextBox x:Name="PathFilterBox" MinHeight="34" Padding="10,0"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[PathList_Filter]}"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[PathList_Filter]}" Margin="10,0,5,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Expander x:Name="AddEntryForm" IsExpanded="{Binding IsAddFormOpen, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_AddEntry]}" FontWeight="SemiBold"/>
                            </Expander.Header>
                            <StackPanel Margin="0,10,0,4">
                                <settings:PathEntryEditor x:Name="AddQuickLaunchEditor" EntryName="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    EntryPath="{Binding NewPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    BrowseFolderCommand="{Binding BrowseFolderCommand}" BrowseFileCommand="{Binding BrowseFileCommand}"/>
                                <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_Add]}" Style="{StaticResource PrimarySettingsButton}"
                                            Command="{Binding AddCommand}" MinWidth="0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                        <ItemsControl x:Name="PathItemsList" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PathListItemTemplate}"
                                      helpers:DragReorder.IsEnabled="True"/>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[PathList_Empty]}" Margin="0,12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=PathItemsList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_ClearFiltersTooltip]}"
                                    Margin="0,0,8,0" Command="{Binding ShowAllCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanReorder}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding ClearLabel}" Style="{StaticResource SettingsButton}"
                                Margin="0" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}"
                                Command="{Binding ClearCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Sources">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock x:Name="RowQuickLaunchSourceTitle"
                                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_SourceTitle]}"
                                   FontWeight="SemiBold" FontSize="14"/>
                        <ItemsControl ItemsSource="{Binding Sources}" helpers:DragReorder.IsEnabled="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="18" Height="24" Background="Transparent"
                                              Cursor="SizeAll" helpers:DragReorder.IsHandle="True">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <Ellipse Grid.Row="0" Width="2.5" Height="2.5" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/><Ellipse Grid.Row="0" Grid.Column="1" Width="2.5" Height="2.5" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                            <Ellipse Grid.Row="1" Width="2.5" Height="2.5" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/><Ellipse Grid.Row="1" Grid.Column="1" Width="2.5" Height="2.5" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                            <Ellipse Grid.Row="2" Width="2.5" Height="2.5" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/><Ellipse Grid.Row="2" Grid.Column="1" Width="2.5" Height="2.5" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                        </Grid>
                                        <CheckBox Grid.Column="1" Content="{Binding Name}" IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_SourceEnabledTooltip]}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="&#xE74A;" Style="{StaticResource PathListIconButton}"
                                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_MoveUpTooltip]}"
                                                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                                    Command="{Binding DataContext.MoveSourceUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="&#xE74B;" Style="{StaticResource PathListIconButton}"
                                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_MoveDownTooltip]}"
                                                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                                    Command="{Binding DataContext.MoveSourceDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Style="{DynamicResource SettingsDetailsExpander}" Margin="0,12,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_SourceDesc]}"
                                           Style="{StaticResource SettingsHintText}" Margin="0,4,0,8"/>
                                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickLaunch_ShiftWheelHint]}" Style="{StaticResource SettingsHintText}"
                                           Margin="0,0,0,10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
