<UserControl x:Class="Lertaro.App.Views.Settings.Hotkey.HotkeyBlacklistTabSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="700">
    <!-- Split out of HotkeySettingsPage.xaml (the "Blacklist" tab) to keep that file under the
         project's line-count convention. DataContext is inherited from the host page: bindings here
         (Blacklist.*) are HotkeySettingsViewModel/BlacklistSettingsViewModel members, same as before
         extraction. Both cards are the one shared ProcessListEditorTemplate (see SettingsWindow.xaml),
         which is also what the quick panel's per-workspace app list uses. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_Hint]}"/>

        <TabControl Background="Transparent" BorderThickness="0" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}">
            <!-- The Windows TabControl template paints its own light content panel. -->
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TabPanel IsItemsHost="True" Background="Transparent" KeyboardNavigation.TabIndex="1"/>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground"><Setter.Value><Binding Path="ForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" FallbackValue="{StaticResource TextPrimary}"/></Setter.Value></Setter>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="Template"><Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value></Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Blacklist_GlobalTitle]}">
                <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0">
                    <ContentControl x:Name="RowBlacklistGlobal" Focusable="False" Content="{Binding Blacklist.Global}"
                                    ContentTemplate="{StaticResource ProcessListEditorTemplate}"/>
                </Border>
            </TabItem>
            <TabItem Header="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_BlacklistTitle]}">
                <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_BlacklistDesc]}"
                                   Style="{StaticResource SettingsHintText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <ContentControl x:Name="RowQuickPanelBlacklist" Focusable="False" Content="{Binding Blacklist.QuickPanel}"
                                        ContentTemplate="{StaticResource ProcessListEditorTemplate}"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
