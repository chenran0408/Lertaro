<UserControl x:Class="Lertaro.App.Views.Settings.General.GeneralSettingsSystemTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <!-- Split out of GeneralSettingsPage.xaml (the "System" tab) to keep that file under the
         project's line-count convention. DataContext is inherited from the host page, so the
         General.Xxx bindings below resolve exactly as they did when this content lived inline. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Page-local copy of FavoritesSettingsPage.xaml's own FavIconButton: same small square
                 icon button used there for its own Browse-file button. -->
            <Style x:Key="BrowseIconButton" TargetType="Button">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground"><Setter.Value><Binding Path="SecondaryForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" FallbackValue="{StaticResource TextSecondary}"/></Setter.Value></Setter>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppIconFontFamily}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,8">
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid x:Name="RowLangSelect">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_LangSelect]}" Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <ComboBox Grid.Column="1" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_LangSelect]}"
                              Style="{StaticResource SettingsComboBox}"
                              ItemsSource="{Binding General.LanguageOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding General.PreferredLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingsSubHeading}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_StartupGroup]}"/>
                <CheckBox x:Name="RowStartup" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_Startup]}"
                           IsChecked="{Binding General.StartWithWindows, Mode=TwoWay}"
                           Margin="0,4"/>

                <CheckBox x:Name="RowAutoCheckUpdates" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_AutoCheckUpdates]}"
                           IsChecked="{Binding General.AutoCheckUpdates, Mode=TwoWay}"
                           Margin="0,4"/>

                <CheckBox x:Name="RowHideTrayIcon" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_HideTrayIcon]}"
                           IsChecked="{Binding General.HideTrayIcon, Mode=TwoWay}"
                           Margin="0,4"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingsSubHeading}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_FoldersGroup]}"/>
                <CheckBox x:Name="RowOpenFoldersInNewExplorerTabs"
                          ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_OpenFoldersInNewExplorerTabsHint]}" AutomationProperties.HelpText="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_OpenFoldersInNewExplorerTabsHint]}" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_OpenFoldersInNewExplorerTabs]}"
                           IsChecked="{Binding General.OpenFoldersInNewExplorerTabs, Mode=TwoWay}"
                           Margin="0,4"/>
                <CheckBox x:Name="RowShowOpenedFoldersInInlineSearch" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_ShowOpenedFoldersInInlineSearch]}"
                           IsChecked="{Binding General.ShowOpenedFoldersInInlineSearch, Mode=TwoWay}"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0">
            <StackPanel>
                <CheckBox x:Name="RowDefaultFileManagerEnabled" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_DefaultFileManagerEnabled]}"
                           IsChecked="{Binding General.FileManager.Enabled, Mode=TwoWay}"
                           Margin="0,4"/>

                <StackPanel x:Name="GroupDefaultFileManagerFields" Visibility="{Binding General.FileManager.Enabled, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_DefaultFileManagerPath]}" Margin="0,4,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RowDefaultFileManagerPath" Grid.Column="0"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding General.FileManager.Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="&#xE8A5;" Style="{StaticResource BrowseIconButton}"
                                ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_DefaultFileManagerBrowseTooltip]}"
                                Command="{Binding General.FileManager.BrowsePathCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_DefaultFileManagerParameter]}" Margin="0,12,0,4"/>
                    <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,4" TextWrapping="Wrap"
                                Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_DefaultFileManagerParameterHint]}"/>
                    <TextBox x:Name="RowDefaultFileManagerParameter"
                             Style="{StaticResource SettingsTextBox}"
                             Text="{Binding General.FileManager.Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingsSubHeading}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_IntegrationGroup]}"/>
                <CheckBox x:Name="RowHardwareAcceleration" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_HardwareAcceleration]}"
                           IsChecked="{Binding General.EnableHardwareAcceleration, Mode=TwoWay}"
                           Margin="0,4"/>

                <CheckBox x:Name="RowEnableEverythingIpc"
                          ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_EnableEverythingIpcDesc]}" AutomationProperties.HelpText="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_EnableEverythingIpcDesc]}" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_EnableEverythingIpc]}"
                           IsChecked="{Binding General.EnableEverythingIpc, Mode=TwoWay}"
                           Margin="0,4"/>

                <Grid x:Name="RowLogLevel" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_LogLevel]}" Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <ComboBox Grid.Column="1" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_LogLevel]}"
                              Style="{StaticResource SettingsComboBox}"
                              ItemsSource="{Binding General.LogLevelOptions}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding General.SelectedLogLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
