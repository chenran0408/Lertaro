<UserControl x:Class="Lertaro.App.Views.Settings.General.GeneralSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             xmlns:local="clr-namespace:Lertaro.App.Views.Settings.General"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource SettingsSectionTitle}"
                        Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_Title]}"/>
            <ListBox Style="{StaticResource SettingsCategoryNavigation}"
                     AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_Title]}"
                     SelectedValue="{Binding General.SelectedTab, Mode=TwoWay}" SelectionChanged="OnCategoryChanged">
                <ListBoxItem Tag="System" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_SysTitle]}"/>
                <ListBoxItem Tag="SearchBehavior" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_SearchBehaviorTitle]}"/>
                <ListBoxItem Tag="Layout" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_LayoutTitle]}"/>
                <ListBoxItem Tag="SearchWindow" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_SearchWindowTitle]}"/>
                <ListBoxItem Tag="PreviewWindow" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_PreviewWindowTitle]}"/>
                <ListBoxItem Tag="QuickNavigation" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_QuickNavTitle]}"/>
                <ListBoxItem Tag="PreviewProviders" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_PreviewProvidersTitle]}"/>
            </ListBox>
            <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}"/>
        </StackPanel>

        <ScrollViewer x:Name="CategoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Grid.IsSharedSizeScope="True">
                <!-- Tab: System (extracted; see GeneralSettingsSystemTab.xaml) -->
                <local:GeneralSettingsSystemTab x:Name="TabSystem">
                    <local:GeneralSettingsSystemTab.Style>
                        <Style TargetType="local:GeneralSettingsSystemTab">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding General.SelectedTab}" Value="System">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:GeneralSettingsSystemTab.Style>
                </local:GeneralSettingsSystemTab>

                <local:GeneralSettingsSearchBehaviorTab x:Name="TabSearchBehavior">
                    <local:GeneralSettingsSearchBehaviorTab.Style>
                        <Style TargetType="local:GeneralSettingsSearchBehaviorTab">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding General.SelectedTab}" Value="SearchBehavior">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:GeneralSettingsSearchBehaviorTab.Style>
                </local:GeneralSettingsSearchBehaviorTab>

                <!-- Tab: Layout (extracted; see GeneralSettingsLayoutTab.xaml) -->
                <local:GeneralSettingsLayoutTab x:Name="TabLayout">
                    <local:GeneralSettingsLayoutTab.Style>
                        <Style TargetType="local:GeneralSettingsLayoutTab">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding General.SelectedTab}" Value="Layout">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:GeneralSettingsLayoutTab.Style>
                </local:GeneralSettingsLayoutTab>

                <!-- Tab: Search Window (extracted; see GeneralSettingsSearchWindowTab.xaml) -->
                <local:GeneralSettingsSearchWindowTab x:Name="TabSearchWindow">
                    <local:GeneralSettingsSearchWindowTab.Style>
                        <Style TargetType="local:GeneralSettingsSearchWindowTab">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding General.SelectedTab}" Value="SearchWindow">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:GeneralSettingsSearchWindowTab.Style>
                </local:GeneralSettingsSearchWindowTab>

                <!-- Tab: Preview Window (extracted; see GeneralSettingsPreviewWindowTab.xaml) -->
                <local:GeneralSettingsPreviewWindowTab x:Name="TabPreviewWindow">
                    <local:GeneralSettingsPreviewWindowTab.Style>
                        <Style TargetType="local:GeneralSettingsPreviewWindowTab">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding General.SelectedTab}" Value="PreviewWindow">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:GeneralSettingsPreviewWindowTab.Style>
                </local:GeneralSettingsPreviewWindowTab>

                <!-- Tab: Quick Navigation (extracted; see GeneralSettingsQuickNavigationTab.xaml) -->
                <local:GeneralSettingsQuickNavigationTab x:Name="TabQuickNavigation">
                    <local:GeneralSettingsQuickNavigationTab.Style>
                        <Style TargetType="local:GeneralSettingsQuickNavigationTab">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding General.SelectedTab}" Value="QuickNavigation">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:GeneralSettingsQuickNavigationTab.Style>
                </local:GeneralSettingsQuickNavigationTab>

                <!-- Tab: Preview Providers (see GeneralSettingsPreviewProvidersTab.xaml) -->
                <local:GeneralSettingsPreviewProvidersTab x:Name="TabPreviewProviders">
                    <local:GeneralSettingsPreviewProvidersTab.Style>
                        <Style TargetType="local:GeneralSettingsPreviewProvidersTab">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding General.SelectedTab}" Value="PreviewProviders">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:GeneralSettingsPreviewProvidersTab.Style>
                </local:GeneralSettingsPreviewProvidersTab>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
