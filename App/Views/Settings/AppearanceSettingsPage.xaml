<UserControl x:Class="Lertaro.App.Views.Settings.AppearanceSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Lertaro.App.Views.Settings"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/Windows/SettingsWindow.xaml"/>
                <ResourceDictionary Source="AppearanceThemeCardTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Card container: no ListBoxItem chrome of its own. Every selection cue (border,
                 checkmark) is drawn inside ThemeCardTemplate below, keyed off IsSelected via a
                 RelativeSource binding, so it can use the theme's own accent color instead of one
                 fixed highlight color for every card. -->
            <Style x:Key="ThemeCardContainerStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <!-- Not Focusable="False": ListBoxItem's own click-to-select handling ties into focus
                     acquisition, so disabling it silently breaks mouse selection. Suppressing just the
                     focus visual (the dotted rectangle) is enough to get the "no chrome" look. -->
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FluentFocusRing}"/>
                <!-- Selecting a ListBoxItem (by click, or programmatically when a mode card switches
                     SelectedThemeId) raises RequestBringIntoView. This ListBox has no ScrollViewer of
                     its own (see ThemeCardListBox's Template below), so that request bubbles straight up
                     to the page's own ScrollViewer and yanks the whole page to wherever the card sits:
                     jarring on its own, and disruptive mid-click since the layout shifts under the
                     cursor before the click even finishes. The grid is small enough to not need
                     scroll-to-reveal in the first place, so this just swallows the request outright. -->
                <EventSetter Event="RequestBringIntoView" Handler="ThemeCard_RequestBringIntoView"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ThemeCardListBox" TargetType="ListBox">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <!-- The card grid is static while the page scrolls (it only changes when the user picks
                     a theme), so caching the whole list to a bitmap makes the outer ScrollViewer pan one
                     pre-rendered surface instead of re-laying out about twenty nested drop-shadow cards
                     every frame: the difference between smooth and visibly stuttering scroll. WPF
                     invalidates the cache on the rare content change (selection, mode switch). -->
                <Setter Property="CacheMode" Value="BitmapCache"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource ThemeCardContainerStyle}"/>
                <Setter Property="ItemTemplate" Value="{StaticResource ThemeCardTemplate}"/>
                <Setter Property="SelectedValuePath" Value="Id"/>
                <!-- Belt-and-suspenders alongside ThemeCardContainerStyle's own EventSetter: when
                     SelectedThemeId changes programmatically (a mode-card switch) right after this
                     ListBox's ItemsSource just swapped to a freshly filtered list, the newly selected
                     item's container can raise RequestBringIntoView before its own ItemContainerStyle
                     has fully applied. Attaching here too, on the ListBox itself, is live from the
                     moment the ListBox exists rather than per-item, so it can't miss that race. -->
                <EventSetter Event="RequestBringIntoView" Handler="ThemeCard_RequestBringIntoView"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <!-- The default ListBox template wraps items in its own ScrollViewer, which swallows
                     mouse-wheel input even with nothing to scroll: hovering the blank space inside
                     the card grid blocked the page's outer ScrollViewer from scrolling. This grid never
                     needs to scroll internally (it just wraps and lets the page grow), so the template
                     drops the ScrollViewer entirely instead of only hiding its scrollbar. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource SettingsSectionTitle}"
                        Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_Title]}"/>

            <ListBox Style="{StaticResource SettingsCategoryNavigation}"
                     AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_Title]}"
                     SelectedValue="{Binding Appearance.SelectedSection, Mode=TwoWay}" SelectionChanged="OnCategoryChanged">
                <ListBoxItem Tag="Theme" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_ThemeSelect]}"/>
                <ListBoxItem Tag="Background" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Background_Title]}"/>
                <ListBoxItem Tag="Taskbar" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_TaskbarTitle]}"/>
            </ListBox>
            <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" PreviewMouseWheel="PageScroll_PreviewMouseWheel"
                      PreviewMouseDown="PageScroll_StopAnimation" PreviewKeyDown="PageScroll_StopAnimation">
            <Grid Margin="0,0,6,12">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Appearance.SelectedSection}" Value="Theme">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubHeading}" Margin="0,0,0,8"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_ModeGroupTitle]}"/>
                            <ListBox x:Name="RowThemeModeCards" Style="{StaticResource SettingsCategoryNavigation}"
                                     Margin="0" SelectedValue="{Binding Appearance.ThemeModeTag, Mode=TwoWay}"
                                     AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_ModeGroupTitle]}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBoxItem Tag="Light" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_ModeLight]}">
                                    <StackPanel>
                                        <Border CornerRadius="6" Height="52" BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" Background="#FFFFFF">
                                            <Border CornerRadius="14" Width="28" Height="28" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Background="#FFFFFF">
                                                <TextBlock Text="&#xE706;" FontFamily="{DynamicResource AppIconFontFamily}"
                                                           FontSize="18" Foreground="#24354B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_ModeLight]}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="Dark" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_ModeDark]}">
                                    <StackPanel>
                                        <Border CornerRadius="6" Height="52" BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" Background="#1E1E1E">
                                            <Border CornerRadius="14" Width="28" Height="28" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Background="#1E1E1E">
                                                <TextBlock Text="&#xE708;" FontFamily="{DynamicResource AppIconFontFamily}"
                                                           FontSize="18" Foreground="#D1E1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_ModeDark]}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="FollowSystem" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_ModeFollowSystem]}">
                                    <StackPanel>
                                        <Border CornerRadius="6" Height="52" BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}">
                                            <Border.Background>
                                                <!-- Fixed light and dark samples used in every active theme. -->
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FFFFFF" Offset="0.49"/>
                                                    <GradientStop Color="#1E1E1E" Offset="0.50"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border CornerRadius="14" Width="28" Height="28" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Background="#1E1E1E">
                                                <TextBlock Text="&#xE895;" FontFamily="{DynamicResource AppIconFontFamily}"
                                                           FontSize="18" Foreground="#D1E1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Appearance_ModeFollowSystem]}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Manual mode: one grid, filtered to whichever flavor (light/dark) is currently active. -->
                    <StackPanel x:Name="GroupManualTheme" Visibility="{Binding Appearance.IsManualThemeEnabled, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource SettingsGroupTitle}"
                                    Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_ThemeSelect]}"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <ListBox x:Name="RowThemeCards" Style="{StaticResource ThemeCardListBox}"
                                     ItemsSource="{Binding Appearance.ManualThemeCards}"
                                     SelectedValue="{Binding Appearance.SelectedThemeId, Mode=TwoWay}"/>
                        </Border>
                    </StackPanel>

                    <Grid x:Name="GroupFollowSystemTheme" Visibility="{Binding Appearance.FollowSystem, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsSubHeading}" Margin="0,0,0,8"
                                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_ThemeLightSelect]}"/>
                                <ListBox x:Name="RowThemeLightCards" Style="{StaticResource ThemeCardListBox}"
                                         ItemsSource="{Binding Appearance.LightThemeCards}"
                                         SelectedValue="{Binding Appearance.SelectedLightThemeId, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsSubHeading}" Margin="0,0,0,8"
                                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_ThemeDarkSelect]}"/>
                                <ListBox x:Name="RowThemeDarkCards" Style="{StaticResource ThemeCardListBox}"
                                         ItemsSource="{Binding Appearance.DarkThemeCards}"
                                         SelectedValue="{Binding Appearance.SelectedDarkThemeId, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <local:BackgroundSettingsSection x:Name="BackgroundSection" DataContext="{Binding Appearance.Background}">
                    <local:BackgroundSettingsSection.Style>
                        <Style TargetType="local:BackgroundSettingsSection">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.Appearance.SelectedSection, RelativeSource={RelativeSource AncestorType=local:AppearanceSettingsPage}}" Value="Background">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:BackgroundSettingsSection.Style>
                </local:BackgroundSettingsSection>

                <local:TaskbarSettingsSection x:Name="RowTaskbarSettings">
                    <local:TaskbarSettingsSection.Style>
                        <Style TargetType="local:TaskbarSettingsSection">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Appearance.SelectedSection}" Value="Taskbar">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:TaskbarSettingsSection.Style>
                </local:TaskbarSettingsSection>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
