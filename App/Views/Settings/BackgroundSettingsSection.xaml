<UserControl x:Class="Lertaro.App.Views.Settings.BackgroundSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             xmlns:controls="clr-namespace:Lertaro.App.Views.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{DynamicResource SettingsGroupTitle}" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Background_Title]}"/>
        <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
                <TextBlock Style="{DynamicResource SettingsHintText}" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Background_Hint]}"/>
                <CheckBox x:Name="RowBackgroundImage" Margin="0,10" IsChecked="{Binding UseImage}"
                          Foreground="{DynamicResource TextPrimary}"
                          Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Background_EnableImage]}"/>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SettingsButton}" Command="{Binding BrowseCommand}"
                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Background_Browse]}"/>
                    <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding ImagePath, Mode=OneWay}" IsReadOnly="True" Padding="8,4"
                             ToolTip="{Binding ImagePath}"/>
                </DockPanel>
                <StackPanel IsEnabled="{Binding UseImage}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextPrimary}" Text="{Binding Opacity, StringFormat={}{0:0}%}"/>
                        <TextBlock Foreground="{DynamicResource TextPrimary}" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Background_Opacity]}"/>
                    </DockPanel>
                    <Slider x:Name="RowBackgroundOpacity" Margin="0,6" Minimum="0" Maximum="100" Value="{Binding Opacity}"
                            SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"
                            ToolTip="{Binding Opacity, StringFormat={}{0:0}%}"/>
                    <TextBlock Style="{DynamicResource SettingsHintText}" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Background_OpacityHint]}"/>
                    <CheckBox Margin="0,8" Foreground="{DynamicResource TextPrimary}" IsChecked="{Binding FitImage}"
                              Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Background_Fit]}"/>
                </StackPanel>
                <Border CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,10" ClipToBounds="True">
                    <Grid Height="130" Background="{DynamicResource ContentBg}">
                        <controls:BackgroundSurface/>
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="12,8"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource TextPrimary}" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Background_Preview]}"/>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Status}" Style="{DynamicResource SettingsHintText}"/>
                <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource SettingsButton}" Command="{Binding CancelCommand}"
                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Background_Undo]}"/>
                    <Button Style="{StaticResource SettingsButton}" Command="{Binding ResetCommand}"
                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Background_Reset]}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
