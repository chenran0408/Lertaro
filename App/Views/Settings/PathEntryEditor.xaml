<UserControl x:Class="Lertaro.App.Views.Settings.PathEntryEditor"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock x:Name="RowFieldPath" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[PathEntry_TargetTitle]}"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" TextWrapping="Wrap"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="&#xE8A5;" Style="{StaticResource RuleIconButton}"
                    Width="32" Height="32" Margin="6,0,0,0" ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_BrowseFileTooltip]}"
                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                    Command="{Binding BrowseFileCommand, ElementName=Root}"
                    CommandParameter="{Binding DataContext, ElementName=Root}"/>
            <Button DockPanel.Dock="Right" Content="&#xED25;" Style="{StaticResource RuleIconButton}"
                    Width="32" Height="32" Margin="6,0,0,0" ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_BrowseFolderTooltip]}"
                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                    Command="{Binding BrowseFolderCommand, ElementName=Root}"
                    CommandParameter="{Binding DataContext, ElementName=Root}"/>
            <TextBox x:Name="TargetBox" MinHeight="32" AutomationProperties.LabeledBy="{Binding ElementName=RowFieldPath}"
                     Text="{Binding EntryPath, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <TextBlock x:Name="RowFieldName" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[PathEntry_NameOptional]}"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,9,0,4" TextWrapping="Wrap"/>
        <TextBox x:Name="NameBox" MinHeight="32" AutomationProperties.LabeledBy="{Binding ElementName=RowFieldName}"
                 Text="{Binding EntryName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
</UserControl>
