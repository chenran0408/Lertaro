<UserControl x:Class="Lertaro.App.Views.Settings.IndexSettings.FoldersTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Templates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Border x:Name="RowFolderRebuild" Style="{StaticResource SettingsCard}">
            <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_IndexStatus]}"
                               FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding NetworkDrive.FolderIndexSummary}"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource SettingsButton}" Margin="0,0,8,4"
                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_RebuildBtn]}"
                            Command="{Binding NetworkDrive.RebuildFoldersCommand}"
                            IsEnabled="{Binding NetworkDrive.CanRebuildFolders}"
                            Visibility="{Binding NetworkDrive.HasFolderIndexes, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource PrimarySettingsButton}" Margin="0,0,8,4"
                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Folder_AddBtn]}"
                            Command="{Binding NetworkDrive.AddFolderCommand}"
                            IsEnabled="{Binding NetworkDrive.CanAddFolder}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingsGroupTitle}" Margin="0,0,0,4"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_FolderIndex]}"/>
                <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,6" TextWrapping="Wrap"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Folder_SectionHint]}"/>
                <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="24,32" Margin="0,8,0,0"
                        Visibility="{Binding NetworkDrive.IsFolderIndexesEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource AppIconFontFamily}" FontSize="36"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Folder_Placeholder]}" FontSize="14"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding NetworkDrive.FolderIndexes}" ItemTemplate="{StaticResource FolderIndexTemplate}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
