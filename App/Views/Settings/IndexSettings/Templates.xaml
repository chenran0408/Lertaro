<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:Lertaro.App.Services">
    <!-- StaticResource inside a DataTemplate resolves against the scope where the template was
         declared, not wherever it's later instantiated. So every key these templates reference
         (BoolToVis from Styles.xaml here, RuleIconButtonAccent/SettingsRow/SettingsButton/
         SettingsComboBox from the app-level dictionaries) has to be merged in directly, not just by
         whichever tab UserControl ends up hosting the ItemsControl that uses this template. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
        <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
        <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
        <ResourceDictionary Source="Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="RuleItemTemplate">
        <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Grid.ColumnSpan="3">
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource AppIconFontFamily}" FontSize="14" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#xE70F;" ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_EditTooltip]}" Style="{StaticResource RuleIconButtonAccent}" Command="{Binding DataContext.Exclusions.EditPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <Button Content="&#xE74D;" ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RemoveTooltip]}" Style="{StaticResource RuleIconButtonAccent}" Command="{Binding DataContext.Exclusions.RemovePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.ColumnSpan="3">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource AppIconFontFamily}" FontSize="14" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="&#xE73E;" Style="{StaticResource RuleIconButtonAccent}" Command="{Binding DataContext.Exclusions.SavePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <Button Content="&#xE711;" Style="{StaticResource RuleIconButtonAccent}" Command="{Binding DataContext.Exclusions.CancelPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

