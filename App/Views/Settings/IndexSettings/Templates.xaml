    <DataTemplate x:Key="LocalDriveTemplate">
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEditEnabled}"
                          AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,5,0,0">
                    <TextBlock Text="{Binding State}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,12,0"/>
                    <TextBlock Foreground="{DynamicResource TextSecondary}">
                        <Run Text="{Binding Kind, Mode=OneWay}"/><Run Text=" · "/>
                        <Run Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderItems], Mode=OneWay}"/>
                        <Run Text=" "/><Run Text="{Binding ItemCount, Mode=OneWay}"/>
                    </TextBlock>
                </WrapPanel>
                <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,5,0,0">
                    <Button Margin="0,0,0,4" VerticalAlignment="Bottom" MinWidth="0"
                            Style="{StaticResource SettingsButton}" Content="{Binding RowActionText}" Command="{Binding RowActionCommand}"
                            IsEnabled="{Binding CanRunRowAction}" Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="NetworkDriveTemplate">
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEditEnabled}"
                          AutomationProperties.Name="{Binding Drive, StringFormat={}{0}:}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Drive, StringFormat={}{0}:}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,5,0,0">
                    <TextBlock Text="{Binding State}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,12,0"/>
                    <TextBlock Foreground="{DynamicResource TextSecondary}">
                        <Run Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderItems], Mode=OneWay}"/>
                        <Run Text=" "/><Run Text="{Binding ItemCount, Mode=OneWay}"/>
                    </TextBlock>
                </WrapPanel>
                <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,5,0,0">
                    <StackPanel Margin="0,0,8,4">
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderMode]}"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,3"/>
                        <ComboBox Width="160" Style="{StaticResource SettingsComboBox}"
                                  AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderMode]}"
                                  ItemsSource="{Binding DataContext.NetworkDrive.RefreshModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding RefreshMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanEditRefreshMode}"/>
                    </StackPanel>
                    <Button Margin="0,0,0,4" VerticalAlignment="Bottom" MinWidth="0"
                            Style="{StaticResource SettingsButton}" Content="{Binding RowActionText}" Command="{Binding RowActionCommand}"
                            IsEnabled="{Binding CanRunRowAction}" Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>
            </Grid>
        </Border>
    </DataTemplate>

