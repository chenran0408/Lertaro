<UserControl x:Class="Lertaro.App.Views.Settings.IndexSettings.WslTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Templates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Border x:Name="RowWslRebuild" Style="{StaticResource SettingsCard}">
            <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_IndexStatus]}"
                               FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding NetworkDrive.WslIndexSummary}"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource SettingsButton}" Margin="0,0,8,4"
                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_RebuildBtn]}"
                            Command="{Binding NetworkDrive.RebuildWslCommand}"
                            IsEnabled="{Binding NetworkDrive.CanRebuildWsl}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingsGroupTitle}" Margin="0,0,0,4"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_WslSectionTitle]}"/>
                <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,6" TextWrapping="Wrap"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_WslSectionHint]}"/>

                <ItemsControl ItemsSource="{Binding NetworkDrive.WslDrives}" ItemTemplate="{StaticResource WslDriveTemplate}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
