<appWindow:AppWindow x:Class="Lertaro.App.Views.Settings.QuickPanel.QuickPanelSizePreviewWindow" xmlns:appWindow="clr-namespace:Lertaro.App.Views.Controls"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:surface="clr-namespace:Lertaro.App.Views.Controls"
 xmlns:services="clr-namespace:Lertaro.App.Services"
 Title="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SizePreview]}"
 Width="640" Height="480"
 ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ShowActivated="False" Background="{DynamicResource ContentBg}" AllowsTransparency="False">
 <appWindow:AppWindow.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></appWindow:AppWindow.Resources>
    <Grid>
        <surface:BackgroundSurface UseTransparentBase="True" />

 <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
    <TextBlock Text="{Binding Width}" FontSize="28"/><TextBlock Text=" &#xD7; " FontSize="28"/><TextBlock Text="{Binding Height}" FontSize="28"/>
   </StackPanel>
   <Slider Width="200" Minimum="280" Maximum="4096" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Width, Mode=TwoWay}" Margin="0,12,0,0"
    AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_WindowWidth]}"/>
   <Slider Width="200" Minimum="200" Maximum="4096" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Height, Mode=TwoWay}" Margin="0,8,0,0"
    AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_WindowHeight]}"/>
   <TextBlock Margin="0,12,0,0" MaxWidth="400" TextWrapping="Wrap" TextAlignment="Center"
    Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_PreviewHint]}"/>
  </StackPanel></ScrollViewer>
    </Grid>
</appWindow:AppWindow>


