<UserControl x:Class="Lertaro.App.Views.Settings.QuickPanel.QuickPanelSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             xmlns:local="clr-namespace:Lertaro.App.Views.Settings.QuickPanel"
             xmlns:helpers="clr-namespace:Lertaro.App.Helpers.Visuals"
             xmlns:conv="clr-namespace:Lertaro.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="760">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:NullToVisibilityConverter x:Key="NullToVis"/>

            <!-- Themed rather than the stock ListBoxItem, whose selection is a flat system-blue block
                 that ignores the app's palette entirely. Same rounded/accent-bar shape the plugin list
                 uses for its own master list, which is the identical job. -->
            <Style x:Key="WorkspaceItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FluentFocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                           RadiusX="1.5" RadiusY="1.5" Fill="Transparent" Margin="0,1"/>
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="6,0,0,0" Padding="8,6">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                    <Setter TargetName="AccentBar" Property="Fill" Value="{DynamicResource AccentBlue}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource SettingsSectionTitle}"
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_QuickPanel]}"/>

            <ListBox Style="{StaticResource SettingsCategoryNavigation}"
                     AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_QuickPanel]}"
                     SelectedValue="{Binding SelectedSection, Mode=TwoWay}">
                <ListBoxItem Tag="Workspaces" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_Workspaces]}"/>
                <ListBoxItem Tag="PluginTabs" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_PluginTabs]}"/>
                <ListBoxItem Tag="Options" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_Options]}"/>
            </ListBox>
            <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,6,12">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Workspaces">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="172" MaxWidth="280"/>
                        <ColumnDefinition Width="2.5*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,14,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="&#xE8C8;" Style="{StaticResource RuleIconButton}"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_DuplicateWorkspace]}"
                                    AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_DuplicateWorkspace]}"
                                    Command="{Binding DuplicateTabCommand}"/>
                            <Button DockPanel.Dock="Right" Content="&#xE710;" Style="{StaticResource RuleIconButton}"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_AddWorkspace]}"
                                    AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_AddWorkspace]}"
                                    Command="{Binding AddTabCommand}"/>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_Workspaces]}"/>
                        </DockPanel>
                        <ListBox x:Name="ListQuickPanelWorkspaces" ItemsSource="{Binding Tabs}"
                                 AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_Workspaces]}"
                                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource WorkspaceItemStyle}"
                                 VerticalAlignment="Top"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False"
                                 HorizontalContentAlignment="Stretch"
                                 BorderThickness="0" Background="Transparent"
                                 helpers:DragReorder.IsEnabled="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Width="14" Height="22" Margin="0,0,6,0" Background="Transparent"
                                              Cursor="SizeAll" helpers:DragReorder.IsHandle="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                            <Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                            <Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                            <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                            <Ellipse Grid.Row="2" Grid.Column="0" Width="2" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                            <Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Margin="1"/>
                                        </Grid>

                                        <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_WorkspaceEnabledTooltip]}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding EffectiveName}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveName}"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0"
                                                    Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}">
                                            <Button Content="&#xE70E;" Style="{StaticResource RuleIconButton}"
                                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_MoveUpTooltip]}"
                                                    Command="{Binding MoveUpSelfCommand}" CommandParameter="{Binding}"/>
                                            <Button Content="&#xE70D;" Style="{StaticResource RuleIconButton}"
                                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_MoveDownTooltip]}"
                                                    Command="{Binding MoveDownSelfCommand}" CommandParameter="{Binding}"/>
                                            <Button Content="&#xE74D;" Style="{StaticResource RuleIconButton}"
                                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_RemoveWorkspace]}"
                                                    Command="{Binding RemoveSelfCommand}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <DockPanel Grid.Column="1" Visibility="{Binding SelectedTab, Converter={StaticResource NullToVis}}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_WorkspaceName]}"
                                       Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <TextBox x:Name="RowQuickPanelWorkspaceName" AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_WorkspaceName]}"
                                         Style="{StaticResource RuleTextBox}"
                                         Text="{Binding SelectedTab.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding SelectedTab.EffectiveName}" IsHitTestVisible="False"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTab.Name}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <local:QuickPanelWorkspaceTabs x:Name="WorkspaceTabs"/>
                    </DockPanel>

                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_NoWorkspaces]}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsHintText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tabs.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="PluginTabs">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,8"
                                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_PluginTabsDesc]}"
                                   Visibility="{Binding HasPluginTabs, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_NoPluginTabs]}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsHintText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPluginTabs}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl x:Name="QuickPanelPluginTabsList" ItemsSource="{Binding PluginTabs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Content="{Binding Name}" IsChecked="{Binding IsOpen, Mode=TwoWay}"/>

                                            <WrapPanel Grid.Column="1">
                                            <ComboBox Margin="0,0,14,0" MinWidth="160" Style="{StaticResource SettingsComboBox}"
                                                      ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding SortMode, Mode=TwoWay}"
                                                      ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_FileOrder]}"/>
                                            <CheckBox IsChecked="{Binding ShowAsList, Mode=TwoWay}"
                                                      Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_ViewList]}"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Options">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <CheckBox x:Name="RowQuickPanelEnabled" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_Enabled]}"/>
                            <Button x:Name="RowWakeShortcut" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Style="{StaticResource LinkButton}" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Wake_Manage]}"
                                    Click="OpenWakeSettings"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid x:Name="RowQuickPanelThumbnailSize" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_ThumbnailSize]}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboBox}"
                                          AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_ThumbnailSize]}"
                                          ItemsSource="{Binding ThumbnailIconSizeOptions}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding ThumbnailIconSize, Mode=TwoWay}"/>
                            </Grid>
                            <local:QuickPanelWindowSizeEditor x:Name="QuickPanelResizeEditor" DataContext="{Binding WindowSize}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
