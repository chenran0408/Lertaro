<appWindow:AppWindow x:Class="Lertaro.App.Views.Onboarding.Tips.TipCardWindow"
             xmlns:appWindow="clr-namespace:Lertaro.App.Views.Controls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             Title="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Tip_Title]}"
             Width="380" SizeToContent="Height" MaxWidth="420"
             WindowStartupLocation="Manual" ResizeMode="NoResize"
             Background="{DynamicResource ContentBg}" AllowsTransparency="False"
             WindowStyle="None" ShowActivated="False" Focusable="False"
             ShowInTaskbar="False"
             TextElement.Foreground="{Binding RelativeSource={RelativeSource Self}, Path=ForegroundBrush}"
             BorderBrush="{Binding RelativeSource={RelativeSource Self}, Path=PanelBorderBrush}" BorderThickness="1">
    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TipTitle" Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
        <TextBlock x:Name="TipBody" Grid.Row="1" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Button x:Name="GotIt" Grid.Row="2" Style="{StaticResource PrimarySettingsButton}"
                HorizontalAlignment="Right" Margin="0,14,0,0"
                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Tip_GotIt]}"
                Click="GotIt_Click"/>
    </Grid>
</appWindow:AppWindow>
