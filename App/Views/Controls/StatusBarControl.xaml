<UserControl x:Class="Lertaro.App.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="600">


    <Border x:Name="StatusBar" BorderThickness="0" Padding="0" Margin="0">
        <Grid Margin="12,4,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="DotStatus" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                     Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtStatusInfo" Grid.Column="1"
                       Text="{Binding StatusText}"
                       TextTrimming="CharacterEllipsis"
                       FontSize="14"
                       Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
