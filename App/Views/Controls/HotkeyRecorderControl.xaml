<UserControl x:Class="Lertaro.App.Views.Controls.HotkeyRecorderControl"
             x:Name="Recorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             Height="26" Width="180"
             AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_RecorderPlaceholder]}">
    <UserControl.Resources>
        <Style x:Key="RecorderBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="ContextMenu" Value="{x:Null}"/>
            <Setter Property="Padding" Value="6,2,20,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="IconButtonBaseStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FluentFocusRing}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <!-- Exactly one of these two is visible at a time: clear while a combo is set, restore once cleared. -->
        <Style x:Key="ClearButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonBaseStyle}">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="&#x2715;" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=HotkeyBox}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, ElementName=HotkeyBox}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RestoreButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonBaseStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="&#x21BA;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=HotkeyBox}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, ElementName=HotkeyBox}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DefaultValue, ElementName=Recorder}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Width="{Binding Width, RelativeSource={RelativeSource AncestorType=UserControl}}"
          Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <TextBox x:Name="HotkeyBox"
                 Style="{StaticResource RecorderBoxStyle}"
                 IsReadOnly="True"
                 ContextMenu="{x:Null}"
                 AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), ElementName=Recorder}"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                 PreviewKeyUp="HotkeyBox_PreviewKeyUp"/>
        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_RecorderPlaceholder]}"
                   Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,22,0" FontSize="12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=HotkeyBox}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Button Style="{StaticResource ClearButtonStyle}"
                Click="ClearButton_Click"
                AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_RecorderClear]}"/>
        <Button Style="{StaticResource RestoreButtonStyle}"
                Click="RestoreButton_Click"
                AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_RecorderRestoreDefault]}"/>
    </Grid>
</UserControl>
