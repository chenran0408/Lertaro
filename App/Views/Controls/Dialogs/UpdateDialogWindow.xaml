<appWindow:AppWindow x:Class="Lertaro.App.Views.Controls.Dialogs.UpdateDialogWindow" xmlns:appWindow="clr-namespace:Lertaro.App.Views.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:surface="clr-namespace:Lertaro.App.Views.Controls"
        xmlns:services="clr-namespace:Lertaro.App.Services"
        Title="Lertaro"
        Width="460" MinHeight="180" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ContentBg}" AllowsTransparency="False"
        WindowStyle="None"
        BorderBrush="{Binding RelativeSource={RelativeSource Self}, Path=PanelBorderBrush}" BorderThickness="1"
        ResizeMode="NoResize"
        TextElement.Foreground="{Binding RelativeSource={RelativeSource Self}, Path=ForegroundBrush}"
        ShowInTaskbar="False"
        Topmost="True">

    <appWindow:AppWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </appWindow:AppWindow.Resources>
    <Grid>
        <surface:BackgroundSurface UseTransparentBase="True" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,12,0">
                        <Image x:Name="TitleBarLogo" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtTitle" Text="Lertaro"
                                    FontSize="14" FontWeight="SemiBold"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Message + optional never-prompt checkbox -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                <StackPanel Margin="20,20">
                    <TextBlock x:Name="TxtMessage" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>

                </StackPanel>
            </ScrollViewer>

            <CheckBox Grid.Row="2" x:Name="ChkNeverPrompt" Margin="20,0,20,12" Visibility="Collapsed"
                              Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[About_NeverPromptAgain]}"
                              Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>

            <!-- Buttons -->
            <Border Grid.Row="3" Background="{DynamicResource StatusBarBg}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,1,0,0" Padding="12,8,16,8">
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnClose" Style="{StaticResource SettingsButton}" Click="BtnClose_Click" IsCancel="True"/>
                    <Button x:Name="BtnSecondary" Style="{StaticResource SettingsButton}" Click="BtnSecondary_Click" Visibility="Collapsed"/>
                    <Button x:Name="BtnPrimary" Style="{StaticResource PrimarySettingsButton}" Click="BtnPrimary_Click"/>
                </WrapPanel>
            </Border>
        </Grid>
    </Grid>
</appWindow:AppWindow>
