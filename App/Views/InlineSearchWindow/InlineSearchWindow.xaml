<appWindow:AppWindow x:Class="Lertaro.App.InlineSearchWindow" xmlns:appWindow="clr-namespace:Lertaro.App.Views.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:surface="clr-namespace:Lertaro.App.Views.Controls"
        xmlns:local="clr-namespace:Lertaro.App"
        xmlns:results="clr-namespace:Lertaro.App.Views.Controls.Results"
        Title="Lertaro Inline"
        Width="465" Height="550" SizeToContent="Manual"
        WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="False" Background="{DynamicResource ContentBg}"
        TextElement.Foreground="{Binding RelativeSource={RelativeSource Self}, Path=ForegroundBrush}"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Focusable="True"
        ShowActivated="False">
    <Grid>
        <surface:BackgroundSurface UseTransparentBase="True" />

    <!-- Outer Grid to support bottom/top alignment of the visible panel inside the transparent window -->
    <Grid x:Name="RootGrid" VerticalAlignment="Bottom">
        <!-- Main card - inverted layout: results on top, search box at bottom -->
        <!-- These named transparent layout wrappers preserve the card's anchor and sizing behavior. The
             GlassWindow/LiquidGlassSurface now provide the single visible glass contour and clipping. -->
        <Border x:Name="MainBorder" Margin="12" Background="Transparent" BorderThickness="0"
                VerticalAlignment="Bottom">
            <Border x:Name="ClippingBorder">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Path preview has its own row and cannot take space from the result list. -->
                        <RowDefinition Height="Auto"/>
                        <!-- Results list. -->
                        <RowDefinition Height="Auto"/>
                        <!-- Separator -->
                        <RowDefinition Height="Auto"/>
                        <!-- Search box (anchored at bottom) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 1. Path Preview -->
                    <!-- Keeping this panel outside the results grid prevents its visibility or text from
                         changing the list's measured height. Its natural height is independent from the
                         result rows, so the complete path can be displayed across as many wrapped lines as
                         it needs. -->
                    <Border x:Name="PathPreviewBorder" Grid.Row="0" Background="Transparent"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="7,7,0,0"
                            Padding="14,8,14,8"
                            Visibility="Collapsed">
                        <TextBlock x:Name="PathPreviewTextBlock"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   LineHeight="16"/>
                    </Border>

                    <!-- 2. Results Container -->
                    <Grid x:Name="ResultsContainerWrapper" Grid.Row="1" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <results:ResultsControl x:Name="ResultsPanelControl" Grid.Row="0"
                                              ItemsSource="{Binding Results}"
                                              SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                              ViewMode="List"
                                              UseInlineActionRows="True"
                                              Visibility="{Binding ResultsPanelVisibility}"/>

                    </Grid>
                    <!-- 3. Separator -->
                    <Rectangle x:Name="ResultsSeparator" Grid.Row="2" Height="1" Fill="{DynamicResource ControlBorderBrush}"
                               Margin="12,0,12,0"
                               Visibility="{Binding ResultsSeparatorVisibility}"/>
                    <!-- 4. Search Box (Bottom Anchored) -->
                    <Border x:Name="SearchBoxBorder" Grid.Row="3" Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7"
                            Padding="12,8,12,8">
                        <local:SearchBoxControl x:Name="SearchBox" FontSize="14" Padding="0" IsIconOnLeft="False"
                                                SearchText="{Binding SearchQuery, Mode=TwoWay}" IsServiceRunning="{Binding IsServiceConnected}"/>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
    </Grid>
</appWindow:AppWindow>

