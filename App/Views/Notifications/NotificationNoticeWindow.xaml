<glass:GlassWindow x:Class="Lertaro.App.Views.Notifications.NotificationNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:glass="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI" xmlns:surface="clr-namespace:Lertaro.App.Views.Controls"
        Title="Notification"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextElement.Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type glass:GlassWindow}}, Path=ForegroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <glass:GlassWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </glass:GlassWindow.Resources>
    <Grid>
        <glass:LiquidGlassSurface x:Name="GlassSurface" />
        <surface:BackgroundSurface UseTransparentBase="True" />


    <!-- The material, edge, shadow, and corner clip are painted by GlassDesk; the text stays clear so the
         optical backdrop remains visible. -->
    <Border x:Name="Surface" Height="36" Padding="12,0" Background="Transparent"
            BorderThickness="0">
        <TextBlock x:Name="Line"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
    </Border>
    </Grid>
</glass:GlassWindow>
