<appWindow:AppWindow x:Class="Lertaro.App.Views.Notifications.NotificationNoticeWindow" xmlns:appWindow="clr-namespace:Lertaro.App.Views.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:surface="clr-namespace:Lertaro.App.Views.Controls"
        Title="Notification"
        SizeToContent="WidthAndHeight" Background="{DynamicResource ContentBg}" AllowsTransparency="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextElement.Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type appWindow:AppWindow}}, Path=ForegroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <appWindow:AppWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </appWindow:AppWindow.Resources>
    <Grid>
        <surface:BackgroundSurface UseTransparentBase="True" />


    <!-- The material, edge, shadow, and corner clip are painted by GlassDesk; the text stays clear so the
         optical backdrop remains visible. -->
    <Border x:Name="Surface" Height="36" Padding="12,0" Background="Transparent"
            BorderThickness="0">
        <TextBlock x:Name="Line"
                   FontSize="14"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
    </Border>
    </Grid>
</appWindow:AppWindow>

