<appWindow:AppWindow x:Class="Lertaro.App.SearchWindow" xmlns:appWindow="clr-namespace:Lertaro.App.Views.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:surface="clr-namespace:Lertaro.App.Views.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Lertaro.App"
        xmlns:converters="clr-namespace:Lertaro.App.Converters"
        xmlns:controls="clr-namespace:Lertaro.App.Views.Controls"
        xmlns:results="clr-namespace:Lertaro.App.Views.Controls.Results"
        xmlns:space="clr-namespace:Lertaro.App.Views.SpaceAnalyzer"
        xmlns:services="clr-namespace:Lertaro.App.Services"
        Title="{Binding WindowTitle}" Height="600" Width="1024"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ContentBg}" AllowsTransparency="False"
        WindowStyle="None"
        TextElement.Foreground="{Binding RelativeSource={RelativeSource Self}, Path=ForegroundBrush}"
        ResizeMode="CanResizeWithGrip">
    <appWindow:AppWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles/Windows/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </appWindow:AppWindow.Resources>
    <Grid>
        <surface:BackgroundSurface UseTransparentBase="True" />

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Title Bar / Search Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Main Content -->
                    <RowDefinition Height="*"/>
                    <!-- Status Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- ═══════════ 1. Title Bar + Search ═══════════ -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}"
                        BorderBrush="{Binding RelativeSource={RelativeSource AncestorType={x:Type appWindow:AppWindow}}, Path=PanelBorderBrush}" BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource CornerRadiusWindowTop}">
                    <Grid x:Name="HeaderDragArea" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Margin="16,0,12,0" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_Title]}"/>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="12,0,12,10"
                                Padding="10,3" Style="{StaticResource SearchFieldChrome}">
                            <app:SearchBoxControl x:Name="SearchBox" FontSize="16" Padding="0" Height="30"
                                                  LeftIconSize="26" RightIconSize="26" MinimumIconFrameSize="24"
                                                  IsIconOnLeft="True" IsIconClickable="True"
                                                  IconClickHint="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[SearchWindow_LogoClickHint]}"
                                                  SearchText="{Binding AdvancedQuery, Mode=TwoWay}"
                                                  IsServiceRunning="{Binding IsServiceConnected}"/>
                        </Border>
                        <!-- Window controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,6,0">
                            <Button x:Name="BtnClearFilters"
                                    Content="&#xE711;"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_ClearFiltersTooltip]}"
                                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                    Command="{Binding ClearAllFiltersCommand}"
                                    Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveFilters}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="BtnToggleFilters"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_HideFiltersTooltip]}"
                                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                    Style="{StaticResource WindowControlButton}"
                                    Click="BtnToggleFilters_Click" Margin="0,0,8,0">
                                <Button.Content>
                                    <Grid Width="36" Height="28">
                                        <TextBlock Text="&#xE71C;" FontFamily="{DynamicResource AppIconFontFamily}"
                                                   FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <!-- Keep a selected-filter cue visible even when the sidebar is collapsed. -->
                                        <Ellipse Width="7" Height="7" Margin="0,3,4,0"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                                 Fill="{DynamicResource AccentBlue}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasActiveFilters}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </Button.Content>
                            </Button>
                            <Button Content="&#xE72B;" ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_BackTooltip]}" Style="{StaticResource WindowControlButton}" Click="BtnBackToQuickSearch_Click" Margin="0,0,8,0"/>
                            <Button Content="&#xE949;" Style="{StaticResource WindowControlButton}" Click="BtnMinimize_Click"/>
                            <Button x:Name="BtnMaximize" Content="&#xE922;" Style="{StaticResource WindowControlButton}" Click="BtnMaximize_Click"/>
                            <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- ═══════════ 2. Main Content ═══════════ -->
                <Grid Grid.Row="1">
                    <space:SpaceAnalyzerView>
                        <space:SpaceAnalyzerView.Style>
                            <Style TargetType="space:SpaceAnalyzerView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowWelcomeHint}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </space:SpaceAnalyzerView.Style>
                    </space:SpaceAnalyzerView>
                    <Grid x:Name="SearchContentLayout">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowWelcomeHint}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <!-- Keep filters readable without allowing a long plugin label to consume the
                             result area. Labels already use ellipsis/tooltips, so a stable column gives
                             the search list predictable room at the window's minimum size. -->
                        <ColumnDefinition x:Name="SidebarColumn" Width="{x:Static app:SearchWindow.FilterSidebarColumnWidth}"/>
                        <!-- Content Area -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Sidebar -->
                    <controls:SearchSidebarControl x:Name="SearchSidebar" Grid.Column="0" Width="{x:Static app:SearchWindow.FilterSidebarWidth}" HorizontalAlignment="Left"/>
                    <!-- Main Results Grid -->
                    <Grid Grid.Column="1" Background="Transparent">
                        <!-- Shared ResultsControl component in Grid Mode -->
                        <results:ResultsControl x:Name="ResultsPanelControl"
                                            ItemsSource="{Binding FilteredResults}"
                                            ChipFilter="{Binding ActiveChip, Mode=TwoWay}"
                                            ViewMode="Grid"
                                            UsesFloatingActionsLayout="True"
                                            UseRoomyActionRows="True"
                                            Visibility="Visible"/>
                        <!-- No Results Hint -->
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_NoResult]}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="20"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}"
                                   >
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowNoResultsHint}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    </Grid>
                </Grid>
                <!-- ═══════════ 3. Status Bar ═══════════ -->
                <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}"
                        BorderBrush="{Binding RelativeSource={RelativeSource AncestorType={x:Type appWindow:AppWindow}}, Path=PanelBorderBrush}" BorderThickness="0,1,0,0"
                        CornerRadius="{StaticResource CornerRadiusWindowBottom}"
                        Padding="16,8,16,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredResults.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowWelcomeHint}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Result count -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentColor}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtResultCount" Text="{Binding ResultCountText}"
                                       ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_HintKeyboard]}"
                                       AutomationProperties.HelpText="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_HintKeyboard]}"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}"
                                       
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSelectedResultCount"
                                       FontSize="14" FontWeight="Medium"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}"
                                       Visibility="Collapsed"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Selection context stays readable even when the results grid is scrolled horizontally. -->
                        <TextBlock Grid.Column="1" Margin="16,0"
                                   Text="{Binding SelectedItem.ParentDir, ElementName=ResultsPanelControl}"
                                   ToolTip="{Binding SelectedItem.FullPath, ElementName=ResultsPanelControl}"
                                   TextTrimming="CharacterEllipsis" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
    </Grid>
</appWindow:AppWindow>

