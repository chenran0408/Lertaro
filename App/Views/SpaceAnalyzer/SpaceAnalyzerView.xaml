<UserControl x:Class="Lertaro.App.Views.SpaceAnalyzer.SpaceAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             SizeChanged="View_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="SpaceListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FluentFocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource CornerRadiusControl}" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpaceBreadcrumbButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Background" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpaceCurrentBreadcrumbButton" TargetType="Button" BasedOn="{StaticResource SpaceBreadcrumbButton}">
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="16,12,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Space_Title]}"
                           FontSize="20" FontWeight="SemiBold" Style="{StaticResource SurfaceTextPrimary}"/>
                <TextBlock x:Name="SummaryText" Margin="0,3,0,0" FontSize="13" TextWrapping="Wrap"
                           Style="{StaticResource SurfaceTextSecondary}"/>
            </StackPanel>
            <CheckBox x:Name="TreemapToggle" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                      Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Space_Treemap]}"
                      Click="TreemapToggle_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource CornerRadiusPopover}" Padding="6,3" Margin="16,0,16,8">
            <DockPanel>
                <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource SpaceBreadcrumbButton}"
                        Width="28" Padding="0" Margin="0,0,2,0" ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Space_Back]}"
                        AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                        Content="&#xE74A;" FontSize="11" FontFamily="{DynamicResource AppIconFontFamily}" Click="Back_Click"/>
                <ScrollViewer x:Name="BreadcrumbScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="7,0,0,0">
                    <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="*"/>
                <ColumnDefinition x:Name="MapColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.ColumnSpan="2" Margin="0,0,0,8">
                <TextBox x:Name="LocationFilter" TextChanged="LocationFilter_TextChanged" MinHeight="32"
                         AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Space_Filter]}"/>
                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Space_Filter]}"
                           Margin="10,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SurfaceTextSecondary}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=LocationFilter}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Border x:Name="MapPane" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"
                    Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CornerRadiusWindow}" Padding="8">
                <Canvas x:Name="TreemapCanvas" SizeChanged="TreemapCanvas_SizeChanged"
                        MouseLeftButtonUp="TreemapCanvas_MouseLeftButtonUp" ClipToBounds="True"/>
            </Border>

            <Border x:Name="ListPane" Grid.Row="1" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CornerRadiusWindow}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="8,5,8,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Space_Name]}"
                                   FontSize="14" FontWeight="SemiBold" Style="{StaticResource SurfaceTextSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Space_Size]}"
                                   FontSize="14" FontWeight="SemiBold" Style="{StaticResource SurfaceTextSecondary}"/>
                    </Grid>
                    <Button x:Name="ParentListButton" Grid.Row="1" Height="34" Margin="0,0,0,3"
                            Style="{StaticResource SpaceBreadcrumbButton}" HorizontalContentAlignment="Left"
                            Visibility="Collapsed" Click="Back_Click">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <TextBlock Text="&#xE74A;" FontFamily="{DynamicResource AppIconFontFamily}" FontSize="11" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Space_Parent]}"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ListBox x:Name="ItemsList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SpaceListItem}"
                             SelectionChanged="ItemsList_SelectionChanged" MouseDoubleClick="ItemsList_MouseDoubleClick"
                             PreviewMouseRightButtonUp="ItemsList_PreviewMouseRightButtonUp" PreviewKeyDown="ItemsList_PreviewKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding ToolTipText}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.RowSpan="2" FontFamily="{DynamicResource AppIconFontFamily}" FontSize="14"
                                               Foreground="{DynamicResource AccentBlue}" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE8A5;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="Text" Value="&#xE8B7;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Style="{StaticResource SurfaceTextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource SurfaceTextSecondary}" FontSize="12" Margin="10,0,0,0"/>
                                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Value="{Binding RelativePercentage}"
                                                 Minimum="0" Maximum="100" Height="3" Margin="0,6,0,0" BorderThickness="0"
                                                 Background="{DynamicResource ControlBorderBrush}" IsHitTestVisible="False"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                                        <StackPanel.Style><Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsVolume}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style></StackPanel.Style>
                                        <TextBlock Text="{Binding CapacityText}" TextWrapping="Wrap" FontSize="14" Style="{StaticResource SurfaceTextSecondary}"/>
                                        <TextBlock Text="{Binding IndexStatusText}" TextWrapping="Wrap" FontSize="14">
                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SurfaceTextSecondary}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsIndexed}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border x:Name="EmptyState" Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusWindow}" Padding="16" Visibility="Collapsed">
                <TextBlock x:Name="EmptyText" FontSize="14" Style="{StaticResource SurfaceTextSecondary}"
                           TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="Transparent" BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LogicalSizeHint" Margin="0,0,10,0" TextWrapping="Wrap"
                           Style="{StaticResource SurfaceTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                <Button x:Name="OpenSelectionButton" Grid.Column="1" IsEnabled="False" Click="OpenSelection_Click"
                        Style="{StaticResource SettingsButton}" MinWidth="0" Height="30"
                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Space_OpenSelection]}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
