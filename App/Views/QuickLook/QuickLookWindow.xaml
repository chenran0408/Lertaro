<appWindow:AppWindow x:Class="Lertaro.App.Views.QuickLook.QuickLookWindow" xmlns:appWindow="clr-namespace:Lertaro.App.Views.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:surface="clr-namespace:Lertaro.App.Views.Controls"
        Title="QuickLook"
        Height="529" Width="400"
        MinHeight="300" MinWidth="300"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource ContentBg}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="CanResizeWithGrip"
        TextElement.Foreground="{Binding RelativeSource={RelativeSource Self}, Path=ForegroundBrush}"
        BorderThickness="0">
    <appWindow:AppWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </appWindow:AppWindow.Resources>
    <Grid>
        <surface:BackgroundSurface UseTransparentBase="True" />

    
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: Icon, Name, Folder. The whole row is the drag handle for the previewed file (see
                 QuickLookWindow.xaml.cs). Background is set explicitly because an unpainted Panel is
                 only hit-testable over its children, so the empty space beside a short filename would
                 otherwise not start a drag. -->
            <Border Grid.Row="0" Padding="12,10" Background="{DynamicResource HeaderBg}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid x:Name="HeaderDragHandle" Background="Transparent" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="ImgFileIcon" Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFileName" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="14" FontWeight="Bold" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtFilePath" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="12" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- Affordance only; the drag target is the whole row above, not just these bars. -->
                <TextBlock x:Name="TxtDragGrip" Grid.Column="2" Text="&#xE76F;" FontFamily="{DynamicResource AppIconFontFamily}"
                           FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Opacity="0.5"
                           VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
            </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10" Background="Transparent">
                <ContentControl x:Name="ContentArea" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>

            <!-- Footer: Size and Dates -->
            <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,1,0,0" Padding="12,8">
            <Grid x:Name="FooterGrid" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFooterSize" Grid.Column="0" FontSize="12" TextTrimming="CharacterEllipsis"
                           MaxWidth="128" Margin="0,0,12,0" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock x:Name="TxtFooterDate" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           TextAlignment="Right" Foreground="{DynamicResource TextSecondary}"/>
            </Grid>
            </Border>
    </Grid>
    </Grid>
</appWindow:AppWindow>

