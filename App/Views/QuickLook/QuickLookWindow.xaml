<glass:GlassWindow x:Class="Lertaro.App.Views.QuickLook.QuickLookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:glass="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI" xmlns:surface="clr-namespace:Lertaro.App.Views.Controls"
        Title="QuickLook"
        Height="529" Width="400"
        MinHeight="300" MinWidth="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="CanResizeWithGrip"
        TextElement.Foreground="{Binding RelativeSource={RelativeSource Self}, Path=ForegroundBrush}"
        BorderThickness="0">
    <glass:GlassWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </glass:GlassWindow.Resources>
    <Grid>
        <glass:LiquidGlassSurface x:Name="GlassSurface" />
        <surface:BackgroundSurface UseTransparentBase="True" />

    
    <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: Icon, Name, Folder. The whole row is the drag handle for the previewed file (see
                 QuickLookWindow.xaml.cs). Background is set explicitly because an unpainted Panel is
                 only hit-testable over its children, so the empty space beside a short filename would
                 otherwise not start a drag. -->
            <Grid x:Name="HeaderDragHandle" Grid.Row="0" Margin="0,0,0,12" Background="Transparent" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="ImgFileIcon" Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFileName" FontSize="14" FontWeight="Bold" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtFilePath" FontSize="11" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- Affordance only; the drag target is the whole row above, not just these bars. -->
                <TextBlock x:Name="TxtDragGrip" Grid.Column="2" Text="&#xE76F;" FontFamily="{DynamicResource AppIconFontFamily}"
                           FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" Opacity="0.5"
                           VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <!-- Separator -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{StaticResource LiquidControlEdge}" Margin="0,0,0,0"/>

            <Grid Grid.Row="1" Margin="0,12,0,12" Background="Transparent">
                <ContentControl x:Name="ContentArea" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>

            <!-- Footer: Size and Dates -->
            <Grid x:Name="FooterGrid" Grid.Row="2" Margin="0,8,0,0" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Background="{StaticResource LiquidControlEdge}" Margin="0,-8,0,8"/>
                <TextBlock x:Name="TxtFooterSize" Grid.Column="0" FontSize="11" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}"/>
                <TextBlock x:Name="TxtFooterDate" Grid.Column="1" FontSize="11" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=SecondaryForegroundBrush}" HorizontalAlignment="Right"/>
            </Grid>
    </Grid>
    </Grid>
</glass:GlassWindow>
