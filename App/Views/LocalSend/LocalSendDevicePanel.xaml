<UserControl x:Class="Lertaro.App.Views.LocalSend.LocalSendDevicePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/LocalSendWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Margin="16,12,16,12" Style="{StaticResource LocalSendListSurface}">
            <Grid>
                <ListBox x:Name="DeviceList" ItemsSource="{Binding DiscoveredDevices}" SelectionMode="Multiple"
                         SelectionChanged="DeviceList_SelectionChanged" ItemContainerStyle="{StaticResource LocalSendSelectableRow}"
                         AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_ChooseDevice]}"
                         Background="Transparent" BorderThickness="0" Margin="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.RowSpan="2" Width="28" Height="28" HorizontalAlignment="Left"
                                        Background="{DynamicResource ContentBg}" CornerRadius="{DynamicResource CornerRadiusControl}">
                                    <Viewbox Width="15" Height="15">
                                        <Path Fill="{DynamicResource TextSecondary}" Data="{Binding DeviceTypeIcon}" Stretch="Uniform"/>
                                    </Viewbox>
                                </Border>
                                <DockPanel Grid.Column="1" Grid.ColumnSpan="2" Margin="6,0,0,2">
                                    <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Insecure]}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowInsecureLabel}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Alias}" ToolTip="{Binding Alias}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,8,0">
                                    <Run Text="#"/><Run Text="{Binding FingerprintTag, Mode=OneWay}"/><Run Text=" · "/>
                                    <Run Text="{Binding IpAddress, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DeviceModel, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ThemeTextBoxStyle}" Width="108" VerticalAlignment="Center"
                                         ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_TargetPin]}"
                                         AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_TargetPin]}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_NoDevicesHint]}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource LocalSendEmptyMessage}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=DeviceList}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource LocalSendActionBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_EditContent]}"
                        Click="Back_Click" Style="{StaticResource SettingsButton}" Margin="0" MinWidth="0" Padding="10,0"
                        HorizontalAlignment="Left"/>
                <Button x:Name="SelectAllButton" Grid.Column="1" Click="SelectAll_Click" Style="{StaticResource SettingsButton}"
                        MinWidth="0" Padding="10,0"/>
                <Button x:Name="SendButton" Grid.Column="2"
                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Send]}"
                        Click="Send_Click" Style="{StaticResource PrimarySettingsButton}" IsDefault="True" IsEnabled="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
