<UserControl x:Class="Lertaro.App.Views.LocalSend.LocalSendCollectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             AllowDrop="True" DragOver="Panel_DragOver" Drop="Panel_Drop">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/LocalSendWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Margin="0,0,0,12" Padding="2" HorizontalAlignment="Left" Style="{StaticResource LocalSendListSurface}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_FilesOrFolders]}"
                                 IsChecked="{Binding IsFilesMode, Mode=OneWay}" Click="FilesMode_Click" Style="{StaticResource SegmentRadioButtonStyle}"/>
                    <RadioButton Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Text]}"
                                 IsChecked="{Binding IsTextMode, Mode=OneWay}" Click="TextMode_Click" Style="{StaticResource SegmentRadioButtonStyle}"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilesMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource LocalSendListSurface}">
                    <Grid>
                        <ListBox x:Name="CollectedList" ItemsSource="{Binding CollectedItems}" Background="Transparent"
                                 AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_FilesOrFolders]}"
                                 BorderThickness="0" Margin="4" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{DynamicResource FluentFocusRing}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Row" Background="Transparent" CornerRadius="{DynamicResource CornerRadiusControl}"
                                                        Padding="8,4" Margin="2,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarSelected}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="&#xE74D;" Click="RemoveItem_Click"
                                                Style="{StaticResource RemoveItemButtonStyle}" Margin="8,0,0,0"
                                                ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Remove]}"
                                                AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Remove]}"/>
                                        <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="15"
                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE8A5;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Text" Value="&#xE8B7;"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Path}" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_DropFilesHint]}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource LocalSendEmptyMessage}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=CollectedList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_AddFiles]}"
                            Click="AddFiles_Click" Style="{StaticResource SettingsButton}" Margin="0,0,8,0"/>
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_AddFolder]}"
                            Click="AddFolder_Click" Style="{StaticResource SettingsButton}" Margin="0"/>
                </WrapPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTextMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBox Text="{Binding TextToSend, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineTextBoxStyle}"
                         AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Text]}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12,8"/>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource LocalSendActionBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}"
                        Click="Cancel_Click" Style="{StaticResource SettingsButton}"/>
                <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_ChooseDevice]}"
                        Click="Next_Click" Style="{StaticResource PrimarySettingsButton}" IsEnabled="{Binding CanGoNextStep}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
