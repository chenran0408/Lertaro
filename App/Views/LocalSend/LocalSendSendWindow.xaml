<appWindow:AppWindow x:Class="Lertaro.App.Views.LocalSend.LocalSendSendWindow"
        xmlns:appWindow="clr-namespace:Lertaro.App.Views.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lertaro.App.Views.LocalSend"
        Title="LocalSend" Height="440" Width="520" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ContentBg}" AllowsTransparency="False"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" Topmost="True"
        UseLayoutRounding="True" TextElement.Foreground="{Binding RelativeSource={RelativeSource Self}, Path=ForegroundBrush}">
    <appWindow:AppWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/LocalSendWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </appWindow:AppWindow.Resources>
    <Grid>
        <appWindow:BackgroundSurface UseTransparentBase="True"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource ContentBg}" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1" Padding="16,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <Image x:Name="TitleBarLogo" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtWindowTitle" FontSize="18" FontWeight="SemiBold"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <local:LocalSendCollectPanel x:Name="CollectPanel" CloseRequested="Panel_CloseRequested"/>
                <local:LocalSendDevicePanel x:Name="DevicePanel" BackRequested="DevicePanel_BackRequested" SendRequested="DevicePanel_SendRequested"/>
                <local:LocalSendSendProgressPanel x:Name="ProgressPanel" ActionRequested="ProgressPanel_ActionRequested"/>
            </Grid>
        </Grid>
    </Grid>
</appWindow:AppWindow>
