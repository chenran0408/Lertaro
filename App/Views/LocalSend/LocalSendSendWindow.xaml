<appWindow:AppWindow x:Class="Lertaro.App.Views.LocalSend.LocalSendSendWindow" xmlns:appWindow="clr-namespace:Lertaro.App.Views.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:surface="clr-namespace:Lertaro.App.Views.Controls"
        xmlns:services="clr-namespace:Lertaro.App.Services"
        xmlns:local="clr-namespace:Lertaro.App.Views.LocalSend"
        Title="LocalSend" Height="400" Width="480" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ContentBg}" AllowsTransparency="False"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" Topmost="True"
        TextElement.Foreground="{Binding RelativeSource={RelativeSource Self}, Path=ForegroundBrush}">
    <appWindow:AppWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </appWindow:AppWindow.Resources>
    <Grid>
        <surface:BackgroundSurface UseTransparentBase="True" />

    <!-- No WindowChrome, deliberately: see the note in LocalSendReceiveWindow. On a transparent window it
         cannot draw or grab its resize border and it takes the ResizeGrip's hit-testing with it, leaving a
         grip that is painted but does not resize. -->
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image x:Name="TitleBarLogo" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtWindowTitle" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_SendWindowTitle]}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ForegroundBrush}"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <local:LocalSendCollectPanel x:Name="CollectPanel" CloseRequested="Panel_CloseRequested" NextRequested="Panel_NextRequested"/>
                    <local:LocalSendDevicePanel x:Name="DevicePanel" CloseRequested="Panel_CloseRequested" SendRequested="DevicePanel_SendRequested"/>
                    <local:LocalSendSendProgressPanel x:Name="ProgressPanel" ActionRequested="ProgressPanel_ActionRequested"/>
                </Grid>
            </Grid>
    </Grid>
</appWindow:AppWindow>

