<appWindow:AppWindow x:Class="Lertaro.App.Views.LocalSend.LocalSendReceiveWindow"
        xmlns:appWindow="clr-namespace:Lertaro.App.Views.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Lertaro.App.Services"
        xmlns:converters="clr-namespace:Lertaro.App.Converters"
        Title="LocalSend" Height="430" Width="500" MinWidth="420" MinHeight="310"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ContentBg}" AllowsTransparency="False"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" Topmost="True"
        UseLayoutRounding="True" TextElement.Foreground="{Binding RelativeSource={RelativeSource Self}, Path=ForegroundBrush}">
    <appWindow:AppWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/LocalSendWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </appWindow:AppWindow.Resources>
    <Grid>
        <appWindow:BackgroundSurface UseTransparentBase="True"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource ContentBg}" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1" Padding="16,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <Image x:Name="TitleBarLogo" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtWindowTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_UploadRequestTitle]}"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="16,12,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource ControlBackground}" CornerRadius="{DynamicResource CornerRadiusControl}">
                        <TextBlock x:Name="TxtProtocol" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Device]}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="TxtSender" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
                <DockPanel Grid.Row="1" x:Name="SelectionRow" Margin="0,8,0,0">
                    <Button x:Name="BtnToggleSelectAll" DockPanel.Dock="Right" Click="BtnToggleSelectAll_Click"
                            Style="{StaticResource SettingsButton}" MinWidth="0" Height="28" Padding="10,0" FontSize="13"/>
                    <TextBlock x:Name="TxtSpeed" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBlue}"
                               FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSummary" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>

            <Border x:Name="FileListBorder" Grid.Row="2" Margin="16,0,16,12" Style="{StaticResource LocalSendListSurface}">
                <ListBox x:Name="LstFiles" Background="Transparent" BorderThickness="0" Margin="4"
                         SelectionMode="Multiple" SelectionChanged="LstFiles_SelectionChanged"
                         AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Files]}"
                         HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource LocalSendSelectableRow}"
                         ItemTemplate="{StaticResource LocalSendProgressFileItemTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True" converters:ScrollViewerHelper.AlwaysShowScrollBarWhenNeeded="True"/>
            </Border>

            <Border x:Name="TextMessageBorder" Grid.Row="2" Margin="16,0,16,12" Visibility="Collapsed">
                <TextBox x:Name="TxtTextMessage" Style="{StaticResource MultiLineTextBoxStyle}" Padding="12,8"
                         AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Text]}"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
            </Border>

            <ProgressBar x:Name="PbTransfer" Grid.Row="3" Height="6" Margin="16,0,16,12"
                         Minimum="0" Maximum="100" Visibility="Collapsed"
                         Foreground="{DynamicResource AccentBlue}" BorderThickness="0"/>

            <Border Grid.Row="4" Style="{StaticResource LocalSendActionBar}">
                <Grid>
                    <Grid x:Name="GridStep1Footer">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnDecline" HorizontalAlignment="Left" Margin="0" MinWidth="0" Padding="12,0"
                                Style="{StaticResource SettingsButton}"
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Decline]}"
                                Click="BtnDecline_Click"/>
                        <Button x:Name="BtnSaveTo" Grid.Column="1" MinWidth="0" Padding="12,0"
                                Style="{StaticResource SettingsButton}"
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_SaveTo]}"
                                Click="BtnSaveTo_Click"/>
                        <Button x:Name="BtnAcceptDefault" Grid.Column="2" MinWidth="0" Padding="12,0"
                                Style="{StaticResource PrimarySettingsButton}"
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_AcceptDefault]}"
                                Click="BtnAcceptDefault_Click"/>
                    </Grid>

                    <WrapPanel x:Name="PanelStep2Footer" Visibility="Collapsed" HorizontalAlignment="Right">
                        <Button x:Name="BtnCloseProgress" Style="{StaticResource SettingsButton}"
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}"
                                Click="BtnCloseProgress_Click"/>
                        <Button x:Name="BtnOpenFolder" Visibility="Collapsed" Style="{StaticResource PrimarySettingsButton}"
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_OpenFolder]}"
                                Click="BtnOpenFolder_Click"/>
                    </WrapPanel>

                    <WrapPanel x:Name="PanelTextFooter" Visibility="Collapsed" HorizontalAlignment="Right">
                        <Button x:Name="BtnCloseText" Style="{StaticResource SettingsButton}"
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Close]}"
                                Click="BtnCloseProgress_Click"/>
                        <Button x:Name="BtnCopyText" Style="{StaticResource PrimarySettingsButton}" Click="BtnCopyText_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</appWindow:AppWindow>
