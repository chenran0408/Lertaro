<UserControl x:Class="Lertaro.App.Views.LocalSend.LocalSendSendProgressPanel"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:Lertaro.App.Views.LocalSend"
              xmlns:converters="clr-namespace:Lertaro.App.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/LocalSendWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedText}" FontSize="12" Foreground="{DynamicResource AccentBlue}"
                           FontWeight="SemiBold" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding ConfirmedCounterText}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource LocalSendListSurface}">
                <ListBox ItemsSource="{Binding TransferItems}" Background="Transparent" BorderThickness="0"
                         Margin="4" Focusable="False" HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource LocalSendProgressListBoxItemStyle}"
                         ItemTemplate="{StaticResource LocalSendProgressFileItemTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True" converters:ScrollViewerHelper.AlwaysShowScrollBarWhenNeeded="True"/>
            </Border>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource LocalSendActionBar}">
            <Button Content="{Binding ActionText, RelativeSource={RelativeSource AncestorType={x:Type local:LocalSendSendProgressPanel}}}"
                    Click="Action_Click" Style="{StaticResource SettingsButton}" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</UserControl>
