<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The service is also launched briefly for install/repair from the GUI. A console-subsystem
         executable flashes a black window during that first-run path; the production service has no
         interactive console, so use the Windows subsystem while keeping Cli/lff.exe as a console app. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RetainVM>false</RetainVM>
    <AssemblyName>Lertaro.Service</AssemblyName>
    <ApplicationIcon>..\App\logo.ico</ApplicationIcon>
    <RootNamespace>Lertaro.Service</RootNamespace>
    <Version>1.1.9</Version>
    <!-- The hook runs from this exe elevated. With startup hooks off, DOTNET_STARTUP_HOOKS set by the user
         cannot load code into it even if the variable reaches it. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\PluginSdk\PluginSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\portable-updater.ps1" Link="portable-updater.ps1"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
