<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Lertaro.Core.Tests</AssemblyName>
    <RootNamespace>Lertaro.SearchBenchmark</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableRustIndexStoreBuild>false</EnableRustIndexStoreBuild>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Core.csproj" AdditionalProperties="EnableRustIndexStoreBuild=false" />
  </ItemGroup>
</Project>
