<UserControl x:Class="Lertaro.Plugins.ClipboardHistory.View.ClipboardPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lertaro.Plugins.ClipboardHistory.View"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True"
             MinWidth="380" MinHeight="420"
             PreviewKeyDown="View_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:ThumbnailImageSourceConverter x:Key="ThumbnailSource"/>
        <Style x:Key="PanelTabChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipBorder" CornerRadius="9" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background"
                                        Value="{DynamicResource ControlHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background"
                                        Value="{DynamicResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- This grid is the inner content; the outer content grid below splits list|preview. -->

        <!-- Search: every keystroke re-filters the loaded history. -->
        <Border Grid.Row="0" CornerRadius="8" Margin="10,10,10,6"
                Background="{DynamicResource ControlBackground}"
                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Margin="10,6" BorderThickness="0"
                         Background="Transparent" VerticalContentAlignment="Center" FontSize="14"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="SearchWatermark" Grid.Column="0" Margin="14,10,0,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                <Button x:Name="ClearSearchButton" Grid.Column="1" Content="✕" Margin="0,0,8,0"
                        BorderThickness="0" Background="Transparent" Cursor="Hand" FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Visibility="Collapsed" Click="ClearSearch_Click"/>
            </Grid>
        </Border>

        <!-- Filter chips: scope the list to one entry kind or the pinned set; the sort toggle
             flips between newest-first and most-copied-first. -->
        <DockPanel Grid.Row="1" Margin="12,2,10,6">
            <ToggleButton x:Name="SortToggle" DockPanel.Dock="Right" Content="⇅" FontSize="12" Padding="7,3"
                          BorderThickness="0" Background="Transparent" Cursor="Hand" ToolTipService.ShowOnDisabled="True"
                          Click="SortToggle_Click"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabAll" Style="{StaticResource PanelTabChip}" GroupName="PanelTabs"
                             IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabText" Style="{StaticResource PanelTabChip}" GroupName="PanelTabs" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabImage" Style="{StaticResource PanelTabChip}" GroupName="PanelTabs" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabFiles" Style="{StaticResource PanelTabChip}" GroupName="PanelTabs" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabFavorites" Style="{StaticResource PanelTabChip}" GroupName="PanelTabs" Checked="Tab_Checked"/>
            </StackPanel>
        </DockPanel>

        <!-- Row 2: list on the left, a preview pane on the right showing the selected entry's
             full text, large image or path list. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
        <!-- The list: group headers are non-selectable rows in the same list, so keyboard
             navigation and the 1~9 quick paste walk one flat sequence. -->
        <ListBox x:Name="Lst" Margin="6,0,6,6" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 SelectionMode="Extended"
                 SelectionChanged="Lst_SelectionChanged"
                 MouseDoubleClick="Lst_MouseDoubleClick"
                 ContextMenuOpening="Lst_ContextMenuOpening"
                 PreviewMouseLeftButtonDown="Lst_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="Lst_PreviewMouseMove">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Resources>
                <DataTemplate DataType="{x:Type local:ClipboardPanelItem}">
                    <Grid>
                        <!-- Group header: a small non-interactive label row. -->
                        <TextBlock Text="{Binding HeaderText}" FontSize="11" FontWeight="SemiBold"
                                   Margin="8,8,0,2" Opacity="0.65"
                                   Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}"/>
                        <!-- Entry row. -->
                        <Border x:Name="RowBorder" CornerRadius="6" Padding="8,6" Margin="2,1"
                                Visibility="{Binding IsRow, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ThumbBox" Grid.Column="0" Width="44" Height="36" CornerRadius="4"
                                        Margin="0,0,8,0" Background="#22808080">
                                    <Image Stretch="Uniform" MaxWidth="42" MaxHeight="34"
                                           Source="{Binding ImagePath, Converter={StaticResource ThumbnailSource}}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <local:HighlightTextBlock Text="{Binding Title}" Query="{Binding Query}"
                                               FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Opacity="0.65"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                            <Setter TargetName="ThumbBox" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                            <Setter TargetName="RowBorder" Property="Background"
                                    Value="{DynamicResource ControlHoverBackground}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>

            <!-- Empty state shown when no row survives the tab and the query. -->
            <TextBlock x:Name="EmptyText" TextAlignment="Center" VerticalAlignment="Center"
                       Margin="20" Opacity="0.6" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                       Visibility="Collapsed"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="CurrentAndNext" ResizeDirection="Columns"/>
            <Border x:Name="PreviewHost" Grid.Column="2" Margin="0,0,6,6" CornerRadius="6" Padding="8"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PreviewTitle" Grid.Row="0" FontSize="11" Opacity="0.65"
                               Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="PreviewContent"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="10,5" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlBorderBrush}">
            <TextBlock x:Name="HintBar" FontSize="10.5" Opacity="0.6"
                       Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
