<UserControl x:Class="Lertaro.Plugins.FileUnlocker.FileOccupationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="PathText" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                 Style="{DynamicResource SettingsTextBox}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Grid.Row="1" Margin="0,8,0,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}"/>
        <Grid Grid.Row="2">
            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Background="{DynamicResource ControlBackground}">
                <ListView x:Name="ProcessList" ItemContainerStyle="{DynamicResource PluginListViewItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          PreviewMouseWheel="ProcessList_PreviewMouseWheel"
                          GridViewColumnHeader.Click="ProcessList_ColumnHeaderClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="NameColumn" Width="160" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn x:Name="PidColumn" Width="80" DisplayMemberBinding="{Binding ProcessId}"/>
                            <GridViewColumn x:Name="PathColumn" Width="360" DisplayMemberBinding="{Binding ExecutablePath}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="12" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
